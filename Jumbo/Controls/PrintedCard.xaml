<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctl="clr-namespace:Jumbo.Controls"
             x:Class="Jumbo.Controls.PrintedCard"
             x:Name="Root">
    <!-- The face of a printed card (like the cards of the box): the level and the number of the word on the top, the picture, the orange wave
         with the word. The colour of the card is the one of the parent (the level colour while playing, green / orange for the answer). -->
    <Grid RowDefinitions="Auto,*,Auto">
        <Grid ColumnDefinitions="*,Auto" Padding="9,7,7,0">
            <Label x:Name="LevelLabel" FontFamily="NunitoBlack" FontSize="15" TextColor="{DynamicResource OnPrimary}" VerticalOptions="Center" />
            <Border Grid.Column="1" x:Name="NumberBadge" MinimumWidthRequest="24" HeightRequest="24" StrokeShape="RoundRectangle 12" Padding="5,0" StrokeThickness="0"
                    BackgroundColor="White" VerticalOptions="Center">
                <Label x:Name="NumberLabel" FontFamily="NunitoBlack" FontSize="11" TextColor="{DynamicResource PrimaryText}" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Grid>
        <ctl:SvgPicture x:Name="Picture" Grid.Row="1" Margin="3,0" InputTransparent="True" BackgroundColor="Transparent" />
        <Grid Grid.Row="2" x:Name="WaveBox" HeightRequest="58">
            <ctl:WaveView />
            <ctl:FitText x:Name="WordText" Margin="4,12,4,2" MaxFontSize="17" MinFontSize="9" FontFamily="NunitoExtraBold" TextColor="{DynamicResource OnBrand}" />
        </Grid>
    </Grid>
</ContentView>
