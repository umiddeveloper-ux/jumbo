<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:u="clr-namespace:Jumbo.Utilities"
             x:Class="Jumbo.Controls.DailyCard">
    <!-- Daily goal ring + streak + the last 7 days (same card as the website's home page). -->
    <Border x:Name="Card" Style="{StaticResource InsetCardStyle}" StrokeShape="RoundRectangle 22" Padding="14">
        <VerticalStackLayout Spacing="12">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Grid WidthRequest="64" HeightRequest="64" VerticalOptions="Center">
                    <GraphicsView x:Name="Ring" WidthRequest="64" HeightRequest="64" InputTransparent="True" />
                    <Label x:Name="RingLabel" FontFamily="NunitoBlack" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>

                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                    <Label Text="{u:Tr Key=Daily_Title}" FontFamily="NunitoExtraBold" FontSize="17" />
                    <Label x:Name="ProgressLabel" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                    <Label x:Name="MessageLabel" FontSize="13" FontFamily="NunitoBold" LineBreakMode="WordWrap" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" Spacing="0" VerticalOptions="Center" HorizontalOptions="Center" MinimumWidthRequest="62">
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="2">
                        <Label x:Name="Flame" Text="🔥" FontSize="22" VerticalOptions="Center" />
                        <Label x:Name="StreakLabel" FontFamily="NunitoBlack" FontSize="24" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Text="{u:Tr Key=Daily_StreakLabel}" FontSize="10" HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                </VerticalStackLayout>
            </Grid>

            <Grid x:Name="WeekGrid" ColumnSpacing="4" />
        </VerticalStackLayout>
    </Border>
</ContentView>
