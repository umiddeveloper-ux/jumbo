<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Jumbo.Controls.ChunkyButton">
    <!-- A "3D" button like the website's: a coloured edge under the face; the face sinks on press. -->
    <Grid x:Name="Root" HeightRequest="56">
        <Border x:Name="Edge" StrokeThickness="0" StrokeShape="RoundRectangle 16" Margin="0,5,0,0" Padding="0" />
        <Border x:Name="Face" StrokeThickness="0" StrokeShape="RoundRectangle 16" Margin="0,0,0,5" Padding="14,0">
            <Label x:Name="Caption" FontFamily="NunitoExtraBold" FontSize="16"
                   HorizontalOptions="Center" VerticalOptions="Center" LineBreakMode="TailTruncation" />
        </Border>
        <Button x:Name="Hit" BackgroundColor="Transparent" BorderWidth="0" Text="" Padding="0" Margin="0,0,0,5"
                MinimumHeightRequest="0" MinimumWidthRequest="0"
                Pressed="OnPressed" Released="OnReleased" Clicked="OnClicked" />
    </Grid>
</ContentView>
