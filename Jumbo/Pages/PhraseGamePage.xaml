<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:u="clr-namespace:Jumbo.Utilities"
             xmlns:ctl="clr-namespace:Jumbo.Controls"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:f="clr-namespace:Fonts"
             xmlns:pageModels="clr-namespace:Jumbo.PageModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Jumbo.Pages.PhraseGamePage"
             x:DataType="pageModels:PhraseGamePageModel"
             x:Name="PhraseGamePageRoot"
             Title="{u:Tr Key=Game_PhraseTitle}"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference PhraseGamePageRoot}, x:DataType=ContentPage}"
            EventName="NavigatedFrom" Command="{Binding NavigatedFromCommand}" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="*, Auto">

        <!-- The round: picture and word, the example in the learner's language, the cells and the words below -->
        <ScrollView Grid.Row="0" IsVisible="{Binding IsPlaying}">
            <VerticalStackLayout Padding="16,10,16,12" Spacing="14" MaximumWidthRequest="640" HorizontalOptions="Fill">

                <ctl:TigerCoach Mood="{Binding Coach.Mood}" Text="{Binding Coach.Text}" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <ProgressBar Progress="{Binding Progress}" ProgressColor="{DynamicResource Success}" HeightRequest="8" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding StepText}" FontFamily="NunitoExtraBold" FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                </Grid>

                <!-- The picture and its word -->
                <Grid ColumnDefinitions="126,*,Auto" ColumnSpacing="12">
                    <!-- the printed card: the picture and the English word on the wave -->
                    <Border StrokeShape="RoundRectangle 16" Padding="0" StrokeThickness="0" BackgroundColor="{DynamicResource Primary}" HeightRequest="176">
                        <ctl:PrintedCard Level="{Binding WordLevel}" Number="{Binding WordNumber}" Svg="{Binding SvgHtml}" Word="{Binding Word}" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="{Binding WordTranslation}" FontFamily="NunitoBlack" FontSize="22" TextColor="{DynamicResource PrimaryText}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="{x:Static f:FluentUI.speaker_2_24_regular}" FontFamily="{x:Static f:FluentUI.FontFamily}" TextColor="{DynamicResource PrimaryText}" FontSize="30" Padding="8" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SpeakWordCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <!-- The example in the learner's own language: this is the phrase to build in English -->
                <Border StrokeShape="RoundRectangle 16" Padding="14,12" StrokeThickness="2"
                        Stroke="{DynamicResource PrimaryEdgeSoft}"
                        BackgroundColor="{DynamicResource PrimarySoft}">
                    <Label Text="{Binding Prompt}" FontFamily="NunitoExtraBold" FontSize="18" HorizontalTextAlignment="Center" />
                </Border>

                <!-- Cells for the words of the phrase: they fill from the left; a tap on a filled cell sends the word back -->
                <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Start" BindableLayout.ItemsSource="{Binding Slots}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="pageModels:PhraseSlot">
                            <Border StrokeShape="RoundRectangle 12" StrokeThickness="2" Padding="12,8" MinimumWidthRequest="52" MinimumHeightRequest="44" Margin="0,0,8,8"
                                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                                    BackgroundColor="Transparent">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding State}" Value="filled">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
                                        <Setter Property="Stroke" Value="{DynamicResource Primary}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding State}" Value="right">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SuccessSoftLight}, Dark={StaticResource SuccessSoftDark}}" />
                                        <Setter Property="Stroke" Value="{DynamicResource Success}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding State}" Value="wrong">
                                        <Setter Property="BackgroundColor" Value="#FFE3E3" />
                                        <Setter Property="Stroke" Value="{DynamicResource Danger}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type pageModels:PhraseGamePageModel}}, Path=ReturnToBankCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Text}" FontFamily="NunitoExtraBold" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <!-- The words of the phrase, mixed up -->
                <FlexLayout Wrap="Wrap" JustifyContent="Center" AlignItems="Start" BindableLayout.ItemsSource="{Binding Bank}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="pageModels:PhraseTile">
                            <Border StrokeShape="RoundRectangle 12" StrokeThickness="2" Padding="14,10" Margin="4,4"
                                    Stroke="{DynamicResource Primary}"
                                    BackgroundColor="{DynamicResource PrimarySoft}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsPlaced}" Value="True">
                                        <Setter Property="Opacity" Value="0.25" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type pageModels:PhraseGamePageModel}}, Path=AppendCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Text}" FontFamily="NunitoExtraBold" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- The Next button stays at the bottom of the screen -->
        <Border Grid.Row="1" IsVisible="{Binding IsPlaying}" StrokeThickness="0" Padding="16,8,16,12"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
            <ctl:ChunkyButton Text="{u:Tr Key=PhraseGame_Next}" IsEnabled="{Binding CanCheck}" Command="{Binding CheckCommand}" />
        </Border>

        <ctl:GameOverlay Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding HasNoData}" Kind="lose" Title="{u:Tr Key=PhraseGame_NoPhrases}"
                         PrimaryText="{u:Tr Key=Common_Back}" PrimaryCommand="{Binding GoBackCommand}" />

        <ActivityIndicator Grid.Row="0" Grid.RowSpan="2" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                           VerticalOptions="Center" HorizontalOptions="Center" Color="{DynamicResource Primary}" HeightRequest="50" WidthRequest="50" />

        <ctl:GameOverlay Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsGameWon}" Kind="win" Title="{u:Tr Key=PhraseGame_Won}"
                         Reward="{Binding RewardText}"
                         PrimaryText="{u:Tr Key=Common_Again}" PrimaryCommand="{Binding RestartGameCommand}"
                         SecondaryText="{u:Tr Key=Common_Back}" SecondaryCommand="{Binding GoBackCommand}" />

        <ctl:GameOverlay Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsGameOver}" Kind="lose" Title="{u:Tr Key=Common_GameOver}"
                         PrimaryText="{u:Tr Key=Common_Again}" PrimaryCommand="{Binding RestartGameCommand}"
                         SecondaryText="{u:Tr Key=Common_Back}" SecondaryCommand="{Binding GoBackCommand}" />

        <ctl:GameOverlay Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsLocked}" Kind="locked" Title="{u:Tr Key=Block_Title}" Message="{Binding LivesService.RegenMessage}"
                         SecondaryText="{u:Tr Key=Common_Back}" SecondaryCommand="{Binding GoBackCommand}" />

    </Grid>
</ContentPage>
