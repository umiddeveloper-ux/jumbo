<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:u="clr-namespace:Jumbo.Utilities"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:Jumbo.PageModels"
             xmlns:models="clr-namespace:Jumbo.Shared.Dtos;assembly=Jumbo.Shared"
             xmlns:strings="clr-namespace:Jumbo.Resources.Strings"
             xmlns:pullToRefresh="clr-namespace:Syncfusion.Maui.Toolkit.PullToRefresh;assembly=Syncfusion.Maui.Toolkit"
             xmlns:progressBar="clr-namespace:Syncfusion.Maui.Toolkit.ProgressBar;assembly=Syncfusion.Maui.Toolkit"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Jumbo.Pages.AlphabetPage"
             x:DataType="pageModels:AlphabetPageModel"
             x:Name="AlphabetPageRoot"
             Title="{u:Tr Key=AlphabetSection}"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference AlphabetPageRoot}, x:DataType=ContentPage}"
            EventName="NavigatedTo"
            Command="{Binding NavigatedToCommand}" />
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference AlphabetPageRoot}, x:DataType=ContentPage}"
            EventName="NavigatedFrom"
            Command="{Binding NavigatedFromCommand}" />
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference AlphabetPageRoot}, x:DataType=ContentPage}"
            EventName="Appearing"
            Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <pullToRefresh:SfPullToRefresh
            IsRefreshing="{Binding IsRefreshing}"
            RefreshCommand="{Binding RefreshCommand}">

            <pullToRefresh:SfPullToRefresh.PullableContent>
                <ScrollView>
                    <VerticalStackLayout Padding="{StaticResource LayoutPadding}"
                                         Spacing="{StaticResource LayoutSpacing}"
                                         IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}">

                        <CollectionView ItemsSource="{Binding Alphabet}" SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical"
                                                 Span="6"
                                                 VerticalItemSpacing="8"
                                                 HorizontalItemSpacing="4" />
                            </CollectionView.ItemsLayout>

                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:LetterItem">
                                    <Grid HeightRequest="60" Padding="0,6,6,0">
                                        <!-- letter tile: colour = how well the words of the letter are repeated -->
                                        <Border StrokeShape="RoundRectangle 16" StrokeThickness="2" Padding="0"
                                                BackgroundColor="{Binding RepetitionLevel, Converter={StaticResource RepetitionLevelToColorConverter}}"
                                                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                                                Opacity="{Binding HasWords, Converter={StaticResource BoolToOpacity}}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type pageModels:AlphabetPageModel}}, Path=LetterSelectedCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Label Text="{Binding Letter}" FontFamily="NunitoBlack" FontSize="24" TextColor="#1B1B1F"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>

                                        <!-- how many words of the letter were met in games -->
                                        <Border BackgroundColor="{DynamicResource Primary}" StrokeThickness="2" StrokeShape="RoundRectangle 9" Padding="5,0"
                                                Stroke="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                                HorizontalOptions="End" VerticalOptions="Start" Margin="0,-6,-6,0" MinimumWidthRequest="20" HeightRequest="20">
                                            <Label Text="{Binding LearnedCount}" TextColor="{DynamicResource OnPrimary}" FontFamily="NunitoBlack" FontSize="11"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </ScrollView>
            </pullToRefresh:SfPullToRefresh.PullableContent>
        </pullToRefresh:SfPullToRefresh>

        <!-- Индикатор загрузки при IsBusy -->
        <ActivityIndicator IsRunning="{Binding IsBusy}"
                       IsVisible="{Binding IsBusy}"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"
                       HeightRequest="50"
                       WidthRequest="50" />
    </Grid>
</ContentPage>
