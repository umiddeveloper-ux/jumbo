<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:Jumbo.PageModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:f="clr-namespace:Fonts"
             x:Class="Jumbo.Pages.SubjectWordsPage"
             x:DataType="pageModels:SubjectWordsPageModel"
             x:Name="SubjectWordsPageRoot"
             Title="{Binding SubjectName}"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference SubjectWordsPageRoot}, x:DataType=ContentPage}"
            EventName="NavigatedFrom"
            Command="{Binding NavigatedFromCommand}" />
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference SubjectWordsPageRoot}, x:DataType=ContentPage}"
            EventName="Appearing"
            Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <Grid>
        <CollectionView ItemsSource="{Binding Words}"
                        SelectionMode="None"
                        Margin="14,10,14,14">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="pageModels:TopicWordItem">
                    <!-- a word is a small printed card: the front stripe in the colour of the level with the number, the word and its translation -->
                    <Border StrokeShape="RoundRectangle 14" Padding="0"
                            StrokeThickness="2"
                            Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                        <Grid ColumnDefinitions="48, *, Auto" ColumnSpacing="12">

                            <!-- Нумерация -->
                            <Grid Grid.Column="0" BackgroundColor="{DynamicResource Primary}">
                                <Label Text="{Binding Number}"
                                       FontFamily="NunitoBlack"
                                       FontSize="15"
                                       TextColor="{DynamicResource OnPrimary}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Grid>

                            <VerticalStackLayout Grid.Column="1" Padding="0,8" Spacing="0" VerticalOptions="Center">
                                <!-- Изучаемое слово -->
                                <Label Text="{Binding Word}"
                                       FontFamily="NunitoExtraBold"
                                       FontSize="18"
                                       LineBreakMode="TailTruncation"/>
                                <!-- Перевод -->
                                <Label Text="{Binding Translate}"
                                       FontFamily="NunitoBold"
                                       FontSize="14"
                                       TextColor="{DynamicResource PrimaryText}"
                                       LineBreakMode="TailTruncation"/>
                            </VerticalStackLayout>

                            <!-- Озвучка -->
                            <Border Grid.Column="2" StrokeShape="RoundRectangle 20" StrokeThickness="0" Padding="0" Margin="0,0,10,0"
                                    WidthRequest="40" HeightRequest="40" VerticalOptions="Center"
                                    BackgroundColor="{DynamicResource PrimarySoft}">
                                <Label Text="{x:Static f:FluentUI.speaker_2_24_regular}" FontFamily="{x:Static f:FluentUI.FontFamily}" FontSize="22"
                                       TextColor="{DynamicResource PrimaryText}" HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type pageModels:SubjectWordsPageModel}}, Path=SpeakCommand}"
                                                          CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"
                           Color="{DynamicResource Primary}"
                           HeightRequest="50"
                           WidthRequest="50"/>
    </Grid>
</ContentPage>
