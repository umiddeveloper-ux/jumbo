<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:u="clr-namespace:Jumbo.Utilities"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:Jumbo.PageModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:ctl="clr-namespace:Jumbo.Controls"
             x:Class="Jumbo.Pages.LetterTestPage"
             x:DataType="pageModels:LetterTestPageModel"
             x:Name="LetterTestPageRoot"
             Title="{u:Tr Key=Letter_TestTitle}"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference LetterTestPageRoot}, x:DataType=ContentPage}"
            EventName="NavigatedTo" Command="{Binding NavigatedToCommand}" />
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference LetterTestPageRoot}, x:DataType=ContentPage}"
            EventName="NavigatedFrom" Command="{Binding NavigatedFromCommand}" />
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference LetterTestPageRoot}, x:DataType=ContentPage}"
            EventName="Appearing" Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *">

        <!-- ══ Прогресс ══ -->
        <VerticalStackLayout Grid.Row="0" Spacing="6" Padding="16,14,16,8">
            <Grid ColumnDefinitions="*, Auto">
                <Label Text="{Binding Letter, Converter={StaticResource TrFormat}, ConverterParameter=Letter_Heading}"
                       FontAttributes="Bold" FontSize="15" VerticalOptions="Center"/>
                <Label Grid.Column="1"
                       Text="{Binding ProgressText}"
                       FontAttributes="Bold" FontSize="15"
                       TextColor="{DynamicResource PrimaryText}"
                       HorizontalOptions="End"/>
            </Grid>
            <ProgressBar Progress="{Binding ProgressValue}"
                         ProgressColor="{DynamicResource Primary}"
                         HeightRequest="10"/>
        </VerticalStackLayout>

        <!-- ══ Контент ══ -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,8,16,20" Spacing="14">

                <!-- Рисунок -->
                <Border StrokeShape="RoundRectangle 20"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        StrokeThickness="0"
                        HeightRequest="200">
                    <ctl:SvgPicture InputTransparent="True" BackgroundColor="Transparent" Svg="{Binding CurrentSvgHtml}" />
                </Border>

                <!-- Английское слово -->
                <Label Text="{Binding CurrentEnglishWord}"
                       FontSize="32"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>

                <!-- Разделитель -->
                <Label Text="{u:Tr Key=Letter_FindTranslation}"
                       FontSize="14"
                       TextColor="{StaticResource Gray500}"
                       HorizontalOptions="Center"/>

                <!-- 4 варианта перевода -->
                <VerticalStackLayout Spacing="10" IsEnabled="{Binding IsInteractive}">
                    <BindableLayout.ItemsSource>
                        <Binding Path="Options"/>
                    </BindableLayout.ItemsSource>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="pageModels:LetterOptionViewModel">
                            <Border StrokeShape="RoundRectangle 14"
                                    StrokeThickness="0"
                                    MinimumHeightRequest="54">

                                <Border.Triggers>
                                    <DataTrigger TargetType="Border"
                                                 Binding="{Binding State}" Value="Normal">
                                        <Setter Property="BackgroundColor"
                                                Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border"
                                                 Binding="{Binding State}" Value="Correct">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource Success}"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border"
                                                 Binding="{Binding State}" Value="Wrong">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Warning}"/>
                                    </DataTrigger>
                                </Border.Triggers>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type pageModels:LetterTestPageModel}}, Path=SelectOptionCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>

                                <Label Text="{Binding Translation}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       HorizontalTextAlignment="Center"
                                       Margin="16,14">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding State}" Value="Correct">
                                            <Setter Property="TextColor" Value="White"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding State}" Value="Wrong">
                                            <Setter Property="TextColor" Value="White"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ══ OVERLAY: Победа ══ -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              IsVisible="{Binding IsGameWon}"
              BackgroundColor="#CC1A7A3D">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="20">
                <Label Text="🎉" FontSize="72" HorizontalOptions="Center"/>
                <Label Text="{Binding Letter, Converter={StaticResource TrFormat}, ConverterParameter=Letter_Learned}"
                       FontSize="24" FontAttributes="Bold" TextColor="White"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                <Button Text="{u:Tr Key=Letter_Again}"
                        Command="{Binding RestartGameCommand}"
                        CornerRadius="24" HeightRequest="50" Padding="32,0"
                        BackgroundColor="White" TextColor="{DynamicResource PrimaryText}"
                        FontAttributes="Bold"/>
                <Button Text="{u:Tr Key=Common_Back}"
                        Command="{Binding GoBackCommand}"
                        CornerRadius="24" HeightRequest="50" Padding="32,0"
                        BackgroundColor="Transparent" TextColor="White"
                        BorderColor="White" BorderWidth="1.5" FontAttributes="Bold"/>
            </VerticalStackLayout>
        </Grid>

        <!-- ══ OVERLAY: Нет слов ══ -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              IsVisible="{Binding HasNoData}"
              BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="16">
                <ctl:TigerView Head="True" Size="96" Mood="sad" HorizontalOptions="Center" />
                <Label Text="{Binding Letter, Converter={StaticResource TrFormat}, ConverterParameter=Letter_NoWords}"
                       FontSize="16" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                <Button Text="{u:Tr Key=Common_Back}" Command="{Binding GoBackCommand}"
                        CornerRadius="24" HeightRequest="48" Padding="30,0"/>
            </VerticalStackLayout>
        </Grid>

        <!-- ══ Загрузка ══ -->
        <ActivityIndicator Grid.Row="0" Grid.RowSpan="2"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           VerticalOptions="Center" HorizontalOptions="Center"
                           Color="{DynamicResource Primary}"
                           HeightRequest="50" WidthRequest="50"/>
    </Grid>
</ContentPage>
