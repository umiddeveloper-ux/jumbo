<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:u="clr-namespace:Jumbo.Utilities"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:Jumbo.PageModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:ctl="clr-namespace:Jumbo.Controls"
             x:Class="Jumbo.Pages.LetterRecallPage"
             x:DataType="pageModels:LetterRecallPageModel"
             x:Name="LetterRecallPageRoot"
             Title="{u:Tr Key=Letter_RecallTitle}"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference LetterRecallPageRoot}, x:DataType=ContentPage}"
            EventName="NavigatedTo" Command="{Binding NavigatedToCommand}" />
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference LetterRecallPageRoot}, x:DataType=ContentPage}"
            EventName="NavigatedFrom" Command="{Binding NavigatedFromCommand}" />
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference LetterRecallPageRoot}, x:DataType=ContentPage}"
            EventName="Appearing" Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *">

        <!-- ══ Прогресс ══ -->
        <VerticalStackLayout Grid.Row="0" Spacing="6" Padding="16,14,16,8">
            <Grid ColumnDefinitions="*, Auto">
                <Label Text="{Binding Letter, Converter={StaticResource TrFormat}, ConverterParameter=Letter_Heading}"
                       FontAttributes="Bold" FontSize="15" VerticalOptions="Center"/>
                <Label Grid.Column="1"
                       Text="{Binding ProgressText}"
                       FontAttributes="Bold" FontSize="15"
                       TextColor="{DynamicResource PrimaryText}"
                       HorizontalOptions="End"/>
            </Grid>
            <ProgressBar Progress="{Binding ProgressValue}"
                         ProgressColor="{DynamicResource Primary}"
                         HeightRequest="10"/>
        </VerticalStackLayout>

        <!-- ══ Карточка ══ -->
        <Grid Grid.Row="1" RowDefinitions="*, Auto" Padding="16,8,16,20">

            <!-- Рисунок + перевод -->
            <VerticalStackLayout Grid.Row="0" Spacing="14" VerticalOptions="Center">

                <Border StrokeShape="RoundRectangle 20"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        StrokeThickness="0"
                        HeightRequest="220">
                    <ctl:SvgPicture InputTransparent="True" BackgroundColor="Transparent" Svg="{Binding CurrentSvgHtml}" />
                </Border>

                <!-- Перевод (подсказка) -->
                <Label Text="{Binding CurrentRussianWord}"
                       FontSize="28"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       TextColor="{DynamicResource PrimaryText}"/>

                <!-- Раскрытое слово -->
                <Border StrokeShape="RoundRectangle 14"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        StrokeThickness="0"
                        Padding="20,14"
                        IsVisible="{Binding IsWordRevealed}">
                    <Label Text="{Binding CurrentEnglishWord}"
                           FontSize="34"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>
                </Border>

            </VerticalStackLayout>

            <!-- Кнопки внизу -->
            <VerticalStackLayout Grid.Row="1" Spacing="12">

                <!-- Кнопка «Показать слово» — до раскрытия -->
                <Border StrokeShape="RoundRectangle 28"
                        BackgroundColor="{DynamicResource Primary}"
                        StrokeThickness="0"
                        HeightRequest="56"
                        IsVisible="{Binding IsWordRevealed, Converter={StaticResource InvertedBoolConverter}}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding RevealWordCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="{u:Tr Key=Letter_ShowWord}"
                           TextColor="{DynamicResource OnPrimary}"
                           FontSize="17"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>

                <!-- Кнопки «Вспомнил / Не вспомнил» — после раскрытия -->
                <VerticalStackLayout Spacing="8" IsVisible="{Binding IsWordRevealed}">

                    <Label Text="{u:Tr Key=Letter_DidRecall}"
                           FontSize="15"
                           HorizontalOptions="Center"
                           TextColor="{StaticResource Gray500}"/>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12">

                        <Border StrokeShape="RoundRectangle 28"
                                BackgroundColor="{StaticResource Success}"
                                StrokeThickness="0"
                                HeightRequest="52">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AnswerCorrectCommand}"/>
                            </Border.GestureRecognizers>
                            <Label Text="{u:Tr Key=Letter_Recalled}"
                                   TextColor="White"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>

                        <Border Grid.Column="1"
                                StrokeShape="RoundRectangle 28"
                                BackgroundColor="{StaticResource Warning}"
                                StrokeThickness="0"
                                HeightRequest="52">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AnswerWrongCommand}"/>
                            </Border.GestureRecognizers>
                            <Label Text="{u:Tr Key=Letter_NotRecalled}"
                                   TextColor="White"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>

                    </Grid>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </Grid>

        <!-- ══ OVERLAY: Итог ══ -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              IsVisible="{Binding IsGameWon}"
              BackgroundColor="#CC1A4A7A">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="20">
                <Label Text="📖" FontSize="72" HorizontalOptions="Center"/>
                <Label Text="{Binding SummaryText}"
                       FontSize="24" FontAttributes="Bold" TextColor="White"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                <Button Text="{u:Tr Key=Letter_Repeat}"
                        Command="{Binding RestartGameCommand}"
                        CornerRadius="24" HeightRequest="50" Padding="32,0"
                        BackgroundColor="White" TextColor="{DynamicResource PrimaryText}"
                        FontAttributes="Bold"/>
                <Button Text="{u:Tr Key=Common_Back}"
                        Command="{Binding GoBackCommand}"
                        CornerRadius="24" HeightRequest="50" Padding="32,0"
                        BackgroundColor="Transparent" TextColor="White"
                        BorderColor="White" BorderWidth="1.5" FontAttributes="Bold"/>
            </VerticalStackLayout>
        </Grid>

        <!-- ══ OVERLAY: Нет слов ══ -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              IsVisible="{Binding HasNoData}"
              BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="16">
                <Label Text="📭" FontSize="56" HorizontalOptions="Center"/>
                <Label Text="{Binding Letter, Converter={StaticResource TrFormat}, ConverterParameter=Letter_NoWords}"
                       FontSize="16" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                <Button Text="{u:Tr Key=Common_Back}" Command="{Binding GoBackCommand}"
                        CornerRadius="24" HeightRequest="48" Padding="30,0"/>
            </VerticalStackLayout>
        </Grid>

        <!-- ══ Загрузка ══ -->
        <ActivityIndicator Grid.Row="0" Grid.RowSpan="2"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           VerticalOptions="Center" HorizontalOptions="Center"
                           Color="{DynamicResource Primary}"
                           HeightRequest="50" WidthRequest="50"/>
    </Grid>
</ContentPage>
