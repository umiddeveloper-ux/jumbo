<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:Jumbo.PageModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:ctl="clr-namespace:Jumbo.Controls"
             xmlns:u="clr-namespace:Jumbo.Utilities"
             x:Class="Jumbo.Pages.SettingsPage"
             x:DataType="pageModels:SettingsPageModel"
             x:Name="SettingsPageRoot"
             Title="{u:Tr Key=SettingsTitle}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference SettingsPageRoot}, x:DataType=ContentPage}"
            EventName="NavigatedTo"
            Command="{Binding NavigatedToCommand}" />
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference SettingsPageRoot}, x:DataType=ContentPage}"
            EventName="Appearing"
            Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="Hint" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="16,12,16,32" Spacing="12" MaximumWidthRequest="640" HorizontalOptions="Fill">

                <Label Text="{u:Tr Key=Settings_Heading}" FontFamily="NunitoBlack" FontSize="28" SemanticProperties.HeadingLevel="Level1" />

                <!-- ── who I am: the avatar and the name, the version (the coin), the ID and the balance ── -->
                <Border Style="{StaticResource CardStyle}" StrokeShape="RoundRectangle 22" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <ctl:AvatarView Avatar="{Binding HeaderAvatar}" Initial="{Binding HeaderName}" Size="64" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding HeaderName}" FontFamily="NunitoBlack" FontSize="20" LineBreakMode="TailTruncation" />
                                <HorizontalStackLayout Spacing="8">
                                    <ctl:PlanCoin Plan="{Binding PlanKey}" Size="20" VerticalOptions="Center" />
                                    <Label Text="{Binding PlanTitle}" FontFamily="NunitoExtraBold" FontSize="14" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding PlanSub}" Style="{StaticResource Hint}" />
                            </VerticalStackLayout>
                        </Grid>
                        <ctl:ChunkyButton Text="{u:Tr Key=Plan_See}" Kind="outline" FontSize="14" Command="{Binding OpenPlansCommand}" />

                        <!-- the ID of the learner (for payments) -->
                        <Border StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="12" IsVisible="{Binding PublicId, Converter={StaticResource StringNotEmpty}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource PrimarySoftDark}}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto">
                                <Label Text="{u:Tr Key=Settings_MyId}" Style="{StaticResource Hint}" />
                                <Label Grid.Row="1" Text="{Binding PublicId}" FontFamily="NunitoBlack" FontSize="24" CharacterSpacing="2" />
                                <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding BalanceText}" FontFamily="NunitoExtraBold" FontSize="15" />
                                <ctl:ChunkyButton Grid.Column="1" Grid.RowSpan="2" Text="{u:Tr Key=Settings_CopyId}" Kind="outline" Command="{Binding CopyIdCommand}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <Label Text="{u:Tr Key=Settings_MyIdHint}" Style="{StaticResource Hint}" IsVisible="{Binding PublicId, Converter={StaticResource StringNotEmpty}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- ── the sections: each one opens its own screen ── -->
                <ctl:SettingsRow Icon="👤" Title="{u:Tr Key=Settings_SecProfile}" Subtitle="{u:Tr Key=Settings_SecProfileSub}"
                                 Command="{Binding OpenSectionCommand}" CommandParameter="SettingsProfilePage" />
                <ctl:SettingsRow Icon="🏫" Title="{u:Tr Key=Settings_SecTeam}" Subtitle="{u:Tr Key=Settings_SecTeamSub}" IsVisible="{Binding IsLearner}"
                                 Command="{Binding OpenSectionCommand}" CommandParameter="SettingsTeamPage" />
                <ctl:SettingsRow Icon="🎯" Title="{u:Tr Key=Settings_SecLearning}" Subtitle="{u:Tr Key=Settings_SecLearningSub}" IsVisible="{Binding IsLearner}"
                                 Command="{Binding OpenSectionCommand}" CommandParameter="SettingsLearningPage" />
                <ctl:SettingsRow Icon="🎨" Title="{u:Tr Key=Settings_SecLook}" Subtitle="{u:Tr Key=Settings_SecLookSub}"
                                 Command="{Binding OpenSectionCommand}" CommandParameter="SettingsLookPage" />
                <ctl:SettingsRow Icon="✈️" Title="{u:Tr Key=PupilBot_Title}" Subtitle="{u:Tr Key=Settings_SecBotSub}" IsVisible="{Binding BotAvailable}"
                                 Command="{Binding OpenSectionCommand}" CommandParameter="SettingsBotPage" />
                <ctl:SettingsRow Icon="🔒" Title="{u:Tr Key=Settings_SecSecurity}" Subtitle="{u:Tr Key=Settings_SecSecuritySub}"
                                 Command="{Binding OpenSectionCommand}" CommandParameter="SettingsSecurityPage" />
                <ctl:SettingsRow Icon="ℹ️" Title="{u:Tr Key=Settings_SecAbout}" Subtitle="{u:Tr Key=Settings_SecAboutSub}"
                                 Command="{Binding OpenSectionCommand}" CommandParameter="SettingsAboutPage" />

                <ctl:ChunkyButton Text="{u:Tr Key=Settings_Logout}" Kind="danger" Command="{Binding LogoutCommand}" Margin="0,8,0,0" />

                <ctl:SettingsRow Icon="🗑️" Title="{u:Tr Key=Settings_DeleteSection}" Subtitle="{u:Tr Key=Settings_SecDeleteSub}" IsDanger="True" IsVisible="{Binding IsLearner}"
                                 Command="{Binding OpenSectionCommand}" CommandParameter="SettingsDeletePage" Margin="0,10,0,0" />

            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                           VerticalOptions="Center" HorizontalOptions="Center" HeightRequest="50" WidthRequest="50" />
    </Grid>
</ContentPage>
