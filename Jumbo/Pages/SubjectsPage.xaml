<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:u="clr-namespace:Jumbo.Utilities"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:Jumbo.PageModels"
             xmlns:strings="clr-namespace:Jumbo.Resources.Strings"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:ctl="clr-namespace:Jumbo.Controls"
             x:Class="Jumbo.Pages.SubjectsPage"
             x:DataType="pageModels:SubjectsPageModel"
             x:Name="SubjectsPageRoot"
             Title="{u:Tr Key=SubjectsTitle}"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference SubjectsPageRoot}, x:DataType=ContentPage}"
            EventName="NavigatedTo"
            Command="{Binding NavigatedToCommand}" />
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference SubjectsPageRoot}, x:DataType=ContentPage}"
            EventName="NavigatedFrom"
            Command="{Binding NavigatedFromCommand}" />
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference SubjectsPageRoot}, x:DataType=ContentPage}"
            EventName="Appearing"
            Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <pullToRefresh:SfPullToRefresh
            xmlns:pullToRefresh="clr-namespace:Syncfusion.Maui.Toolkit.PullToRefresh;assembly=Syncfusion.Maui.Toolkit"
            IsRefreshing="{Binding IsRefreshing}"
            RefreshCommand="{Binding RefreshCommand}">

            <pullToRefresh:SfPullToRefresh.PullableContent>
                <CollectionView ItemsSource="{Binding Subjects}" SelectionMode="None" Margin="{StaticResource LayoutPadding}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="pageModels:SubjectItemViewModel">
                            <Border StrokeShape="RoundRectangle 12" 
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" 
                                    StrokeThickness="0">
                                <Border.Shadow>
                                    <Shadow Brush="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}" Offset="0,2" Radius="4" Opacity="0.05"/>
                                </Border.Shadow>

                                <Grid ColumnDefinitions="60, *, 40" Padding="12" HeightRequest="70">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type pageModels:SubjectsPageModel}}, Path=SelectSubjectCommand}"
                                            CommandParameter="{Binding .}"/>
                                    </Grid.GestureRecognizers>

                                    <Label Grid.Column="0" Text="{Binding Number}" FontFamily="NunitoBlack" FontSize="28" TextColor="{DynamicResource PrimaryText}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />

                                    <Label Grid.Column="1" 
                                           Text="{Binding Name}" 
                                           Style="{StaticResource LabelMedium}" 
                                           FontAttributes="Bold" 
                                           VerticalOptions="Center" 
                                           Margin="12,0,0,0"/>

                                    <Border Grid.Column="2" 
                                            WidthRequest="28" 
                                            HeightRequest="28" 
                                            StrokeShape="RoundRectangle 14" 
                                            BackgroundColor="{StaticResource Success}" 
                                            StrokeThickness="0"
                                            HorizontalOptions="End" 
                                            VerticalOptions="Center"
                                            IsVisible="{Binding IsPassed}">
                                        <Label Text="✓" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" FontSize="14"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Margin="0,50,0,0" Spacing="10">
                            <Label Text="📚" FontSize="40" HorizontalOptions="Center"/>
                            <Label Text="{u:Tr Key=NoSubjectsFound}" Style="{StaticResource LabelMedium}" TextColor="{StaticResource Gray500}" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </pullToRefresh:SfPullToRefresh.PullableContent>
        </pullToRefresh:SfPullToRefresh>

        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"
                           Color="{DynamicResource Primary}"
                           HeightRequest="50"
                           WidthRequest="50" />
    </Grid>
</ContentPage>