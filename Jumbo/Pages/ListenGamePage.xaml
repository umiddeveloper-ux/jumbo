<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:u="clr-namespace:Jumbo.Utilities"
             xmlns:ctl="clr-namespace:Jumbo.Controls"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:Jumbo.PageModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Jumbo.Pages.ListenGamePage"
             x:DataType="pageModels:ListenAndFindGamePageModel"
             x:Name="ListenGamePageRoot"
             Title="{u:Tr Key=Game_ListenTitle}"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference ListenGamePageRoot}, x:DataType=ContentPage}"
            EventName="NavigatedTo" Command="{Binding NavigatedToCommand}" />
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference ListenGamePageRoot}, x:DataType=ContentPage}"
            EventName="NavigatedFrom" Command="{Binding NavigatedFromCommand}" />
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference ListenGamePageRoot}, x:DataType=ContentPage}"
            EventName="Appearing" Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- Row 0: прогресс | Row 1: кнопки | Row 2: 4 карточки -->
    <Grid RowDefinitions="Auto, Auto, *">

        <!-- ══ ROW 0: Прогресс ══ -->
        <VerticalStackLayout Grid.Row="0" Spacing="6" Padding="16,14,16,6">
            <Grid ColumnDefinitions="*, Auto">
                <Label Text="{u:Tr Key=Game_ListenTitle}"
                       FontAttributes="Bold"
                       FontSize="15"
                       VerticalOptions="Center"/>
                <Label Grid.Column="1"
                       Text="{Binding ProgressText}"
                       FontAttributes="Bold"
                       FontSize="15"
                       HorizontalOptions="End"
                       TextColor="{DynamicResource PrimaryText}"/>
            </Grid>
            <ProgressBar Progress="{Binding ProgressValue}"
                         ProgressColor="{DynamicResource Primary}"
                         HeightRequest="10"/>
            <ctl:TigerCoach Mood="{Binding Coach.Mood}" Text="{Binding Coach.Text}" />
        </VerticalStackLayout>

        <!-- ══ ROW 1: Кнопки управления ══ -->
        <Grid Grid.Row="1" Padding="16,8">

            <!-- Обычный режим: 🔊 + 👁️ -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="16"
                                   IsVisible="{Binding IsDeafMode, Converter={StaticResource InvertedBoolConverter}}">
                <Border StrokeShape="RoundRectangle 34"
                        BackgroundColor="{DynamicResource Primary}"
                        StrokeThickness="0"
                        WidthRequest="68" HeightRequest="68">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SpeakWordCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="🔊" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>

                <Border StrokeShape="RoundRectangle 34"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                        StrokeThickness="0"
                        WidthRequest="68" HeightRequest="68">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleDeafModeCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="👁️" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
            </HorizontalStackLayout>

            <!-- Режим для глухих: слово + кнопки -->
            <VerticalStackLayout HorizontalOptions="Center" Spacing="8"
                                 IsVisible="{Binding IsDeafMode}">
                <Border StrokeShape="RoundRectangle 12"
                        BackgroundColor="{DynamicResource Primary}"
                        StrokeThickness="0"
                        Padding="24,10"
                        HorizontalOptions="Center">
                    <Label Text="{Binding TargetWordText}"
                           FontSize="32" FontAttributes="Bold" TextColor="{DynamicResource OnPrimary}"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                </Border>
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="12">
                    <Border StrokeShape="RoundRectangle 28"
                            BackgroundColor="{DynamicResource Primary}"
                            StrokeThickness="0"
                            WidthRequest="56" HeightRequest="56">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SpeakWordCommand}"/>
                        </Border.GestureRecognizers>
                        <Label Text="🔊" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Border StrokeShape="RoundRectangle 28"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                            StrokeThickness="0"
                            WidthRequest="56" HeightRequest="56">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleDeafModeCommand}"/>
                        </Border.GestureRecognizers>
                        <Label Text="🙈" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Grid>

        <!-- ══ ROW 2: Все 4 карточки (2×2) ══ -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding AllCards}"
                        SelectionMode="None"
                        IsEnabled="{Binding IsInteractive}"
                        Margin="12,6,12,12">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="2"
                                 HorizontalItemSpacing="10"
                                 VerticalItemSpacing="10"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="pageModels:ListenCardViewModel">
                    <Border StrokeShape="RoundRectangle 16"
                            StrokeThickness="0">

                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding ResultState}" Value="None">
                                <Setter Property="BackgroundColor"
                                        Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding ResultState}" Value="Correct">
                                <Setter Property="BackgroundColor" Value="{StaticResource Success}"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding ResultState}" Value="Wrong">
                                <Setter Property="BackgroundColor" Value="{StaticResource Warning}"/>
                            </DataTrigger>
                        </Border.Triggers>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type pageModels:ListenAndFindGamePageModel}}, Path=SelectCardCommand}"
                                CommandParameter="{Binding .}"/>
                        </Border.GestureRecognizers>

                        <Grid RowDefinitions="*, Auto" Padding="8">
                            <ctl:SvgPicture Grid.Row="0"
                                     HeightRequest="110"
                                     InputTransparent="True"
                                     BackgroundColor="Transparent" Svg="{Binding SvgHtml}" />
                            <Label Grid.Row="1"
                                   Text="{Binding TranslationWord}"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="2"
                                   Padding="4,4,4,2"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

<ctl:GameOverlay Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding IsGameOver}" Kind="lose" Title="{u:Tr Key=FindMeGame_OutOfLives}"
                          PrimaryText="{u:Tr Key=Common_TryAgainLong}" PrimaryCommand="{Binding RestartGameCommand}"
                          SecondaryText="{u:Tr Key=Common_Back}" SecondaryCommand="{Binding GoBackCommand}" />

<ctl:GameOverlay Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding IsGameWon}" Kind="win" Title="{u:Tr Key=FindMeGame_Great}" Message="{u:Tr Key=ListenGame_Won}"
                          Reward="{Binding RewardText}"
                          PrimaryText="{u:Tr Key=Common_Again}" PrimaryCommand="{Binding RestartGameCommand}"
                          SecondaryText="{u:Tr Key=Common_Back}" SecondaryCommand="{Binding GoBackCommand}" />

<ctl:GameOverlay Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding HasNoData}" Kind="lose" Title="{u:Tr Key=FindMeGame_NoWords}"
                          PrimaryText="{u:Tr Key=Common_Back}" PrimaryCommand="{Binding GoBackCommand}" />

        <!-- ══ Индикатор загрузки ══ -->
        <ActivityIndicator Grid.Row="0" Grid.RowSpan="3"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"
                           Color="{DynamicResource Primary}"
                           HeightRequest="50" WidthRequest="50"/>

<ctl:GameOverlay Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding IsLocked}" Kind="locked" Title="{u:Tr Key=Block_Title}" Message="{Binding LivesService.RegenMessage}"
                          SecondaryText="{u:Tr Key=Common_Back}" SecondaryCommand="{Binding GoBackCommand}" />

    </Grid>
</ContentPage>
