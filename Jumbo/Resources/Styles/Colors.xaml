<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- ===== Jumbo palette (same values as the website, jumbo-theme.css) ===== -->
    <Color x:Key="Primary">#1CB0F6</Color>
    <Color x:Key="PrimaryDark">#1899D6</Color>
    <Color x:Key="PrimaryEdge">#1480B8</Color>
    <Color x:Key="PrimaryDarkText">#06263A</Color>
    <Color x:Key="PrimarySoftLight">#DDF4FF</Color>
    <Color x:Key="PrimarySoftDark">#17384F</Color>
    <Color x:Key="PrimaryEdgeLight">#84D8FF</Color>
    <Color x:Key="PrimaryEdgeDark">#2F6F94</Color>
    <Color x:Key="Secondary">#DDF4FF</Color>
    <Color x:Key="SecondaryDarkText">#6FD0FF</Color>
    <Color x:Key="Tertiary">#7C4DFF</Color>
    <Color x:Key="Accent">#FF9600</Color>
    <Color x:Key="AccentEdge">#CC7800</Color>

    <Color x:Key="Success">#58CC02</Color>
    <Color x:Key="SuccessEdge">#46A302</Color>
    <Color x:Key="SuccessText">#46A302</Color>
    <Color x:Key="SuccessTextDark">#7BE02B</Color>
    <Color x:Key="SuccessSoftLight">#E5F8D2</Color>
    <Color x:Key="SuccessSoftDark">#1F3B18</Color>
    <Color x:Key="Warning">#FF9600</Color>
    <Color x:Key="WarningAsbestos">#FFF4C2</Color>
    <Color x:Key="Danger">#FF4B4B</Color>
    <Color x:Key="DangerEdge">#C93B3B</Color>
    <Color x:Key="DangerSoftLight">#FFE3E3</Color>
    <Color x:Key="DangerSoftDark">#4A2327</Color>
    <Color x:Key="AnswerButton">#1CB0F6</Color>

    <!-- page / card / border / text, light and dark -->
    <Color x:Key="LightBackground">#DDEAF3</Color>
    <Color x:Key="DarkBackground">#0E1A2B</Color>
    <Color x:Key="SurfaceLight">#F5FAFD</Color>
    <Color x:Key="SurfaceDark">#17263A</Color>
    <Color x:Key="BorderLight">#C2D5E3</Color>
    <Color x:Key="BorderDark">#2A3E57</Color>
    <Color x:Key="DarkOnLightBackground">#1F3A5F</Color>
    <Color x:Key="LightOnDarkBackground">#E8F0F8</Color>
    <Color x:Key="MutedLight">#6B849C</Color>
    <Color x:Key="MutedDark">#93A9BF</Color>
    <Color x:Key="DisabledTextLight">#A9BDCE</Color>
    <Color x:Key="DisabledTextDark">#5E738A</Color>

    <Color x:Key="LightSecondaryBackground">#F5FAFD</Color>
    <Color x:Key="DarkSecondaryBackground">#17263A</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#1F3A5F</Color>
    <Color x:Key="OffBlack">#17263A</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C2D5E3</Color>
    <Color x:Key="Gray300">#A9BDCE</Color>
    <Color x:Key="Gray400">#93A9BF</Color>
    <Color x:Key="Gray500">#6B849C</Color>
    <Color x:Key="Gray600">#3A4E66</Color>
    <Color x:Key="Gray900">#1F3A5F</Color>
    <Color x:Key="Gray950">#0E1A2B</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
