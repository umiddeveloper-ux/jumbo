<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- ===== Jumbo palette (same values as the website, jumbo-theme.css): a neutral base + the orange of the brand ===== -->
    <!-- The keys below the line "changing colours" are rewritten while the app runs by Services/ThemePalette (the colour of the level of the book,
         light / dark): use them with {DynamicResource}. The values here are only the start. -->
    <!-- changing colours -->
    <Color x:Key="PrimarySoft">#FFF0DC</Color>
    <Color x:Key="PrimaryEdgeSoft">#FFDEAD</Color>
    <Color x:Key="OnPrimary">#1B1B1F</Color>
    <Color x:Key="PrimaryText">#B45F00</Color>
    <Color x:Key="Brand">#F6AF57</Color>
    <Color x:Key="BrandDark">#E6A24D</Color>
    <Color x:Key="OnBrand">#1B1B1F</Color>
    <Color x:Key="Primary">#F6AF57</Color>
    <Color x:Key="PrimaryDark">#E6A24D</Color>
    <Color x:Key="PrimaryEdge">#D69A4D</Color>
    <Color x:Key="PrimaryDarkText">#1B1B1F</Color>
    <Color x:Key="PrimarySoftLight">#FFF0DC</Color>
    <Color x:Key="PrimarySoftDark">#3A2A12</Color>
    <Color x:Key="PrimaryEdgeLight">#FFD08A</Color>
    <Color x:Key="PrimaryEdgeDark">#7A4C0A</Color>
    <Color x:Key="Secondary">#FFF0DC</Color>
    <Color x:Key="SecondaryDarkText">#FFA733</Color>
    <Color x:Key="Tertiary">#7C4DFF</Color>
    <Color x:Key="Accent">#FF9600</Color>
    <Color x:Key="AccentEdge">#CC7800</Color>

    <Color x:Key="Success">#8ADB4E</Color>
    <Color x:Key="SuccessEdge">#46A302</Color>
    <Color x:Key="SuccessText">#3E9202</Color>
    <Color x:Key="SuccessTextDark">#7BE02B</Color>
    <Color x:Key="SuccessSoftLight">#E5F8D2</Color>
    <Color x:Key="SuccessSoftDark">#1F3B18</Color>
    <Color x:Key="Warning">#FF9600</Color>
    <Color x:Key="WarningAsbestos">#FFF4C2</Color>
    <Color x:Key="Danger">#FF8181</Color>
    <Color x:Key="DangerText">#D93636</Color>
    <Color x:Key="DangerEdge">#C93B3B</Color>
    <Color x:Key="DangerSoftLight">#FFE3E3</Color>
    <Color x:Key="DangerSoftDark">#4A2327</Color>
    <Color x:Key="AnswerButton">#F28C0F</Color>

    <!-- page / card / border / text, light and dark -->
    <Color x:Key="LightBackground">#F3F5F8</Color>
    <Color x:Key="DarkBackground">#0C0C0E</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#1C1C21</Color>
    <Color x:Key="BorderLight">#D9DEE6</Color>
    <Color x:Key="BorderDark">#34343C</Color>
    <Color x:Key="DarkOnLightBackground">#1B1B1F</Color>
    <Color x:Key="LightOnDarkBackground">#F2F2F4</Color>
    <Color x:Key="MutedLight">#6B7280</Color>
    <Color x:Key="MutedDark">#A1A1AA</Color>
    <Color x:Key="DisabledTextLight">#A3A9B3</Color>
    <Color x:Key="DisabledTextDark">#6B6B75</Color>

    <Color x:Key="LightSecondaryBackground">#FFFFFF</Color>
    <Color x:Key="DarkSecondaryBackground">#1C1C21</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#1B1B1F</Color>
    <Color x:Key="OffBlack">#1C1C21</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#D9DEE6</Color>
    <Color x:Key="Gray300">#A3A9B3</Color>
    <Color x:Key="Gray400">#A1A1AA</Color>
    <Color x:Key="Gray500">#6B7280</Color>
    <Color x:Key="Gray600">#3F3F46</Color>
    <Color x:Key="Gray900">#1B1B1F</Color>
    <Color x:Key="Gray950">#0C0C0E</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
