<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Jumbo"
             xmlns:utilities="clr-namespace:Jumbo.Utilities"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Jumbo.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <ResourceDictionary Source="Resources/Styles/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <utilities:RepetitionLevelToColorConverter x:Key="RepetitionLevelToColorConverter" />
            <utilities:PercentToFractionConverter x:Key="PercentToFraction" />
            <utilities:TrFormatConverter x:Key="TrFormat" />
            <toolkit:BoolToObjectConverter x:Key="BoolToOpacity" x:TypeArguments="x:Double" TrueObject="1" FalseObject="0.45" />
            <toolkit:IsNotNullConverter x:Key="NotNullToBool" />
            <toolkit:IsStringNotNullOrEmptyConverter x:Key="StringNotEmpty" />
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <toolkit:BoolToObjectConverter x:Key="StepMood" x:TypeArguments="x:String" TrueObject="cheer" FalseObject="wave" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
