<!DOCTYPE html>
@using JumboWeb.Services
<html lang="@_lang">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <script>
        // Apply the saved (or system) theme before first paint to avoid a light flash.
        (function () {
            var t = null;
            try { t = localStorage.getItem('jumbo-theme'); } catch (e) { }
            if (t !== 'dark' && t !== 'light')
                t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            document.documentElement.setAttribute('data-theme', t);
            // the colour theme bought in the market (the page sets the right one of the learner once it knows who it is)
            try { var p = localStorage.getItem('lp-palette'); if (p) document.documentElement.setAttribute('data-palette', p); } catch (e) { }
        })();
    </script>
    <script>
        // First visit, nobody has picked a language yet: guess it from the country. The browser's time zone tells the country without
        // asking for the location and without calling any outside service: Uzbekistan -> Uzbek, Russia and the Russian-speaking
        // countries -> Russian; elsewhere the browser's language (uz / ru / en), else English. The guess is kept in the "jumbo-geo"
        // cookie for 30 days, the page is rendered again once if the server had chosen another language. A language picked with the
        // switch ("jumbo-lang" cookie) or saved in the profile always wins.
        (function () {
            var UZ = { 'Asia/Tashkent': 1, 'Asia/Samarkand': 1 };
            var RU = {};
            ('Europe/Kaliningrad Europe/Moscow Europe/Simferopol Europe/Kirov Europe/Volgograd Europe/Astrakhan Europe/Saratov Europe/Ulyanovsk Europe/Samara ' +
             'Asia/Yekaterinburg Asia/Omsk Asia/Novosibirsk Asia/Barnaul Asia/Tomsk Asia/Novokuznetsk Asia/Krasnoyarsk Asia/Irkutsk Asia/Chita Asia/Yakutsk ' +
             'Asia/Khandyga Asia/Vladivostok Asia/Ust-Nera Asia/Magadan Asia/Sakhalin Asia/Srednekolymsk Asia/Kamchatka Asia/Anadyr ' +
             'Europe/Minsk Asia/Almaty Asia/Qyzylorda Asia/Qostanay Asia/Aqtobe Asia/Aqtau Asia/Atyrau Asia/Oral Asia/Bishkek Asia/Dushanbe Asia/Ashgabat ' +
             'Europe/Kyiv Europe/Kiev Europe/Uzhgorod Europe/Zaporozhye Europe/Chisinau Asia/Yerevan Asia/Baku').split(' ').forEach(function (z) { RU[z] = 1; });

            window.lpDetectLang = function (tz, langs) {
                if (UZ[tz]) return 'uz';
                if (RU[tz]) return 'ru';
                for (var i = 0; i < (langs || []).length; i++) {
                    var l = String(langs[i]).toLowerCase();
                    if (l.indexOf('uz') === 0) return 'uz';
                    if (l.indexOf('ru') === 0) return 'ru';
                    if (l.indexOf('en') === 0) return 'en';
                }
                return 'en';
            };

            try {
                if (/(^|;\s*)(jumbo-lang|jumbo-geo)=/.test(document.cookie)) return;
                var tz = (Intl.DateTimeFormat().resolvedOptions().timeZone) || '';
                var code = window.lpDetectLang(tz, navigator.languages || [navigator.language]);
                document.cookie = 'jumbo-geo=' + code + '; path=/; max-age=2592000; samesite=lax';
                // reload only when the cookie was really stored (no endless reloads when cookies are blocked)
                if (/(^|;\s*)jumbo-geo=/.test(document.cookie) && document.documentElement.lang !== code) window.location.reload();
            } catch (e) { }
        })();
    </script>
    <ResourcePreloader />
