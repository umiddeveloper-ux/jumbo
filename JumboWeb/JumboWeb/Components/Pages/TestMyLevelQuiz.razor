@page "/test-my-level/quiz"
@rendermode InteractiveServer
@using JumboWeb.Services
@using Jumbo.Shared
@implements IDisposable
@inject LpApiClient ApiClient
@inject TestLevelStateService TestState
@inject AppLocalizer Loc
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@Loc["SiteLayout_TestNav"]</PageTitle>

<div class="exam-page">
    <div class="game-topbar">
        <button class="lp-back-btn" @onclick='() => Nav.NavigateTo("/test-my-level")'>@Loc["Common_BackArrow"]</button>
        @if (_question is not null)
        {
            <span class="exam-counter">@Loc.Format("Placement_PartN", _part, _index + 1, _block!.Questions.Count)</span>
        }
    </div>

    @if (_question is not null)
    {
        <div class="listen-progress-wrap">
            <div class="listen-progress-bar">
                <div class="listen-progress-fill" style="width:@(_progressPct)%"></div>
            </div>
        </div>
    }

    @if (_busy)
    {
        <div class="lp-spinner-wrap">@Loc["Common_Loading"]</div>
    }
    else if (_failed)
    {
        <div class="lp-empty-state">@Loc["Placement_Error"]</div>
        <button class="lp-btn lp-btn-full" style="margin-top:12px" @onclick="StartAsync">@Loc["ExamResults_Retry"]</button>
    }
    else if (_interlude)
    {
        <div class="game-result-card">
            <div class="game-result-icon"><Tiger Mood="cheer" Size="130" /></div>
            <div class="game-result-title">@Loc["Placement_GoodTitle"]</div>
            <div class="game-result-sub">@Loc["Placement_GoodText"]</div>
            <button class="lp-btn lp-btn-full" @onclick="ContinueAsync">@Loc["Placement_Continue"] →</button>
        </div>
    }
    else if (_question is { } q)
    {
        <div class="pl-instruction">
            <span class="pl-skill">@Loc["Placement_Skill_" + q.Skill]</span>
            <span class="pl-do">@Loc[q.Skill == PlacementSkill.Vocabulary && q.SvgImageId is null ? "Placement_Do_vocabularytext" : "Placement_Do_" + q.Skill]</span>
        </div>

        @if (q.Skill == PlacementSkill.Reading)
        {
            <div class="pl-passage">
                <b>@q.PassageTitle</b>
                <p>@q.Passage</p>
            </div>
        }

        @if (q.Skill == PlacementSkill.Vocabulary && q.SvgImageId is not null)
        {
            <div class="letter-test-card pl-picture">
                <div class="letter-test-svg">@((MarkupString)_svg)</div>
            </div>
        }
        else
        {
            @if (q.Skill == PlacementSkill.Listening)
            {
                @if (_speechOk)
                {
                    <button type="button" class="lp-btn pl-listen" disabled="@(_speaking || _plays >= MaxPlays)" @onclick="PlayAsync">
                        @(_speaking ? Loc["Placement_Playing"] : _plays == 0 ? Loc["Placement_Listen"] : Loc["Placement_ListenAgain"])
                    </button>
                }
                else
                {
                    @* No speech in this browser: the text is read instead. *@
                    <div class="pl-passage"><i>@Loc["Placement_NoSpeech"]</i><p>@string.Join(" ", q.Audio)</p></div>
                }
            }
            @if (!string.IsNullOrEmpty(q.Prompt))
            {
                <div class="pl-prompt">@q.Prompt</div>
            }
        }

        <div class="letter-options-list">
            @for (var i = 0; i < q.Options.Count; i++)
            {
                var idx = i;
                <button class="answer-option @(_selected == idx ? "selected" : "")" @onclick="() => _selected = idx">
                    <span class="answer-letter">@((char)('A' + idx))</span>
                    <span class="answer-word">@q.Options[idx]</span>
                </button>
            }
        </div>

        <button class="lp-btn lp-btn-full" style="margin-top:14px" disabled="@(_selected < 0)" @onclick="NextAsync">
            @(IsLastOfBlock ? Loc["ExamQuiz_Finish"] : Loc["ExamQuiz_Next"])
        </button>
    }
</div>

@code {
    private const int MaxPlays = 2;

    private PlacementBlockDto? _block;
    private int _level;                     // the index of the block in PlacementScoring.Levels (0 = A1)
    private int _part => _level + 1;
    private int _index;
    private int _selected = -1;
    private string _svg = string.Empty;
    private readonly List<PlacementAnswer> _answers = new();
    private readonly List<double> _shares = new();      // the share of right answers in each block taken so far
    private bool _busy = true, _failed, _interlude;

    // listening
    private bool _speechOk = true, _speaking;
    private int _plays;

    private PlacementQuestionDto? _question => _block is not null && _index < _block.Questions.Count ? _block.Questions[_index] : null;
    private bool IsLastOfBlock => _block is not null && _index + 1 >= _block.Questions.Count;
    private double _progressPct => _block is { Questions.Count: > 0 } ? _index * 100.0 / _block.Questions.Count : 0;

    protected override async Task OnInitializedAsync()
    {
        try { _speechOk = await JS.InvokeAsync<bool>("lp.speechAvailable"); } catch { _speechOk = false; }
        await StartAsync();
    }

    private async Task StartAsync()
    {
        _busy = true;
        _failed = false;
        _answers.Clear();
        _shares.Clear();
        _level = 0;
        try
        {
            if (!await LoadBlockAsync(PlacementScoring.Levels[0])) _failed = true;
        }
        catch { _failed = true; }
        _busy = false;
    }

    private async Task<bool> LoadBlockAsync(string level)
    {
        var block = await ApiClient.GetPlacementBlockAsync(level);
        if (block is null || block.Questions.Count == 0) return false;
        _block = block;
        _index = 0;
        await ShowQuestionAsync();
        return true;
    }

    private async Task ShowQuestionAsync()
    {
        _selected = -1;
        _plays = 0;
        _speaking = false;
        _svg = string.Empty;
        if (_question is { SvgImageId: { } svgId })
        {
            try { _svg = await ApiClient.GetSvgByIdAsync(svgId); } catch { }
        }
    }

    private async Task PlayAsync()
    {
        if (_speaking || _plays >= MaxPlays || _question is not { } q) return;
        _plays++;
        _speaking = true;
        StateHasChanged();
        try { await JS.InvokeAsync<bool>("lp.speakLines", q.Audio, "en-US"); } catch { }
        _speaking = false;
    }

    private async Task NextAsync()
    {
        if (_selected < 0 || _question is not { } q || _block is null) return;
        await CancelSpeechAsync();
        _answers.Add(new PlacementAnswer { Question = q, Selected = _selected });
        _index++;

        if (_index < _block.Questions.Count)
        {
            await ShowQuestionAsync();
            return;
        }

        // The end of a block: the next level follows only when this one went well (and there is a next one).
        var mine = _answers.Where(a => a.Question.Level == _block.Level).ToList();
        _shares.Add(mine.Count(a => a.IsCorrect) / (double)mine.Count);
        if (PlacementScoring.GoesOn(_shares[^1]) && _level + 1 < PlacementScoring.Levels.Length)
        {
            _interlude = true;
            _index = _block.Questions.Count;
            return;
        }
        Finish();
    }

    private async Task ContinueAsync()
    {
        _interlude = false;
        _busy = true;
        _level++;
        try
        {
            if (!await LoadBlockAsync(PlacementScoring.Levels[_level]))
            {
                // The next block could not be loaded: the result is what the blocks before it showed.
                Finish();
                return;
            }
        }
        catch { Finish(); return; }
        _busy = false;
    }

    private void Finish()
    {
        TestState.SetResults(_answers.ToList(), _shares.ToList());
        Nav.NavigateTo("/test-my-level/results", replace: true);
    }

    private async Task CancelSpeechAsync()
    {
        try { await JS.InvokeVoidAsync("lp.cancelLines"); } catch { }
    }

    public void Dispose() => _ = CancelSpeechAsync();
}
