@page "/r/{Token}/exams"
@layout BlankLayout
@rendermode InteractiveServer
@using JumboWeb.Services
@using Jumbo.Shared.Dtos
@inject LpApiClient ApiClient
@inject AppLocalizer Loc
@inject IJSRuntime JS

<PageTitle>@(_r is null ? Loc["XR_Title"] : $"{Loc["XR_Title"]}: {_r.SchoolName}")</PageTitle>
<HeadContent><meta name="robots" content="noindex, nofollow" /></HeadContent>
<div class="top-controls rp-noprint"><LanguageSwitcher /><ThemeToggle /></div>

@* The exam report of the school by teams for the director: reached from the Telegram bot through the secret link of the school report.
   It names the pupils, so it is never indexed and never cached. *@
@if (!_loaded)
{
    <div class="lp-spinner-wrap">@Loc["Common_Loading"]</div>
}
else if (_r is null)
{
    <div class="rp rp-center">
        <Tiger Mood="idle" Size="120" />
        <h1 class="rp-title">@Loc["XR_Title"]</h1>
        <p class="rp-note">@Loc["RP_NotFound"]</p>
    </div>
}
else
{
    var t = _r.Totals;
    <div class="rp xr">
        <header class="rp-head">
            <div>
                <div class="rp-brand"><img src="favicon.svg" alt="" /> Jumbo.uz</div>
                <h1 class="rp-title">📝 @_r.SchoolName</h1>
                <p class="rp-sub">@Loc["XR_Title"] · @Loc[$"Region_{_r.Region}"] · @Fmt(_r.Period.From) – @Fmt(_r.Period.To)</p>
            </div>
            <div class="rp-tools rp-noprint">
                <div class="rate-period">
                    <button type="button" class="rate-chip @(_period == "week" ? "on" : "")" @onclick='() => SetPeriodAsync("week")'>@Loc["RP_Week"]</button>
                    <button type="button" class="rate-chip @(_period == "month" ? "on" : "")" @onclick='() => SetPeriodAsync("month")'>@Loc["RP_Month"]</button>
                    <button type="button" class="rate-chip @(_period == "term" ? "on" : "")" @onclick='() => SetPeriodAsync("term")'>@Loc["XR_Term"]</button>
                </div>
                <button type="button" class="lp-btn lp-btn-sm lp-btn-outline" @onclick="Print">🖨 @Loc["RP_Print"]</button>
                <button type="button" class="lp-btn lp-btn-sm lp-btn-outline" @onclick="ExportAsync">📊 @Loc["RP_Excel"]</button>
                <a class="xr-link" href="/r/@Token">@Loc["XR_ToActivity"]</a>
            </div>
        </header>

        <div class="rp-kpis">
            <ReportKpi Label="@Loc["XR_ExamsHeld"]" Value="@t.ExamsHeld.ToString()" />
            <ReportKpi Label="@Loc["XR_Attempts"]" Value="@t.Attempts.ToString()" />
            <ReportKpi Label="@Loc["XR_Participation"]" Value="@($"{t.Participants}/{t.Pupils}")" />
            <ReportKpi Label="@Loc["XR_AvgResult"]" Value="@(t.AvgPercent is { } a ? $"{a}%" : "—")" />
            <ReportKpi Label="@Loc["XR_Teams"]" Value="@t.Teams.ToString()" />
        </div>

        @if (_r.Teams.Count > 0)
        {
            <section class="rp-card">
                <h2 class="rp-h2">@Loc["XR_Teams"]</h2>
                <div class="te-table-wrap">
                    <table class="te-table xr-table">
                        <thead>
                            <tr>
                                <th>@Loc["RP_ColTeam"]</th>
                                <th>@Loc["XR_ColTeacher"]</th>
                                <th class="num">@Loc["XR_ColPupils"]</th>
                                <th class="num">@Loc["XR_Participation"]</th>
                                <th class="num">@Loc["XR_Attempts"]</th>
                                <th class="num">@Loc["XR_AvgResult"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var team in _r.Teams)
                            {
                                <tr>
                                    <td class="name">@team.TeamName</td>
                                    <td>@(team.TeacherName ?? "—")</td>
                                    <td class="num">@team.Pupils</td>
                                    <td class="num">@team.Participants/@team.Pupils</td>
                                    <td class="num">@team.Attempts</td>
                                    <td class="num">@Percent(team.AvgPercent)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }

        @foreach (var team in _r.Teams)
        {
            <section class="rp-card xr-team">
                <h2 class="rp-h2">@team.TeamName @if (!string.IsNullOrEmpty(team.TeacherName)) { <small class="xr-teacher">· @team.TeacherName</small> }</h2>
                <p class="rp-note">
                    @Loc["XR_Participation"]: <b>@team.Participants/@team.Pupils</b> ·
                    @Loc["XR_Attempts"]: <b>@team.Attempts</b> ·
                    @Loc["XR_AvgResult"]: <b>@Percent(team.AvgPercent)</b>
                </p>

                @if (team.Pupils == 0)
                {
                    <p class="rp-note">@Loc["XR_NoPupils"]</p>
                }
                else
                {
                    <h3 class="xr-h3">@Loc["XR_PupilsList"]</h3>
                    <div class="te-table-wrap">
                        <table class="te-table xr-table">
                            <thead>
                                <tr>
                                    <th class="num">#</th>
                                    <th>@Loc["TE_ColPupil"]</th>
                                    <th class="num">@Loc["XR_ColExams"]</th>
                                    <th class="num">@Loc["XR_ColBest"]</th>
                                    <th class="num">@Loc["XR_ColLast"]</th>
                                    <th class="num">@Loc["XR_ColDate"]</th>
                                    <th class="num te-total-col">@Loc["TE_ColTotal"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ var n = 0; }
                                @foreach (var p in team.PupilRows)
                                {
                                    n++;
                                    <tr>
                                        <td class="num">@n</td>
                                        <td class="name">@p.Name</td>
                                        <td class="num">@(p.Exams > 0 ? p.Exams.ToString() : "—")</td>
                                        <td class="num">@PercentChip(p.BestPercent)</td>
                                        <td class="num">@PercentChip(p.LastPercent)</td>
                                        <td class="num">@(p.LastDate is { } d ? Fmt(d) : "—")</td>
                                        <td class="num te-total-col"><b>@p.WordsTotal</b></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <h3 class="xr-h3">@Loc["XR_ExamsList"]</h3>
                @if (team.Exams.Count == 0)
                {
                    <p class="rp-note">@Loc["XR_NoExams"]</p>
                }
                else
                {
                    <div class="te-table-wrap">
                        <table class="te-table xr-table">
                            <thead>
                                <tr>
                                    <th>@Loc["XR_ColDate"]</th>
                                    <th>@Loc["XR_ColTeacher"]</th>
                                    <th class="num">@Loc["XR_ColQuestions"]</th>
                                    <th class="num">@Loc["XR_Participation"]</th>
                                    <th class="num">@Loc["XR_AvgResult"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var e in team.Exams)
                                {
                                    <tr>
                                        <td>@Fmt(e.Date)</td>
                                        <td>@(e.TeacherName ?? "—")</td>
                                        <td class="num">@e.Questions</td>
                                        <td class="num">@e.Participants</td>
                                        <td class="num">@PercentChip(e.AvgPercent)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }

        @if (_r.Teams.Count == 0)
        {
            <section class="rp-card"><p class="rp-note">@Loc["RP_NoTeams"]</p></section>
        }

        <p class="rp-note xr-scope">@Loc["XR_Scope"]</p>
        <p class="rp-foot">@Loc.Format("RP_Generated", _r.GeneratedAt.AddHours(5).ToString("dd.MM.yyyy HH:mm")) · Jumbo.uz</p>
    </div>
}

@code {
    [Parameter] public string Token { get; set; } = string.Empty;

    // ?period=week|month|term (the bot's buttons use it); the month by default
    [SupplyParameterFromQuery(Name = "period")] public string? PeriodParam { get; set; }

    private bool _loaded;
    private string _period = "month";
    private SchoolExamReportDto? _r;

    protected override async Task OnInitializedAsync()
    {
        _period = ExamReportPeriods.Normalize(PeriodParam);
        _r = await ApiClient.GetPublicSchoolExamReportAsync(Token, _period);
        _loaded = true;
    }

    private async Task SetPeriodAsync(string period)
    {
        _period = period;
        _r = await ApiClient.GetPublicSchoolExamReportAsync(Token, _period) ?? _r;
    }

    private async Task Print() => await JS.InvokeVoidAsync("lp.printPage");

    private async Task ExportAsync()
    {
        if (_r is null) return;
        var sheets = new List<(string Name, IReadOnlyList<IReadOnlyList<object?>> Rows)>();

        var overview = new List<IReadOnlyList<object?>>
        {
            new List<object?> { Loc["RP_ColTeam"], Loc["XR_ColTeacher"], Loc["XR_ColPupils"], Loc["XR_Participation"], Loc["XR_Attempts"], Loc["XR_AvgResult"] + " %" }
        };
        foreach (var team in _r.Teams) overview.Add(new List<object?> { team.TeamName, team.TeacherName, team.Pupils, team.Participants, team.Attempts, team.AvgPercent });
        sheets.Add((Loc["XR_Teams"], overview));

        foreach (var team in _r.Teams)
        {
            var rows = new List<IReadOnlyList<object?>>
            {
                new List<object?> { "#", Loc["TE_ColPupil"], Loc["XR_ColExams"], Loc["XR_ColBest"] + " %", Loc["XR_ColLast"] + " %", Loc["XR_ColDate"], Loc["TE_ColTotal"] }
            };
            var n = 0;
            foreach (var p in team.PupilRows)
                rows.Add(new List<object?> { ++n, p.Name, p.Exams, p.BestPercent, p.LastPercent, p.LastDate is { } d ? Fmt(d) : null, p.WordsTotal });
            sheets.Add((team.TeamName, rows));
        }

        var bytes = XlsxWriter.BuildWorkbook(sheets);
        var file = $"Jumbo-exams-{Safe(_r.SchoolName)}-{_r.Period.Key}-{DateTime.UtcNow.AddHours(5):yyyy-MM-dd}.xlsx";
        await JS.InvokeVoidAsync("lp.downloadFile", file, Convert.ToBase64String(bytes), XlsxWriter.MimeType);
    }

    private static string Safe(string s) => new string(s.Select(ch => char.IsLetterOrDigit(ch) ? ch : '-').ToArray()).Trim('-');

    private static string Fmt(DateOnly d) => d.ToString("dd.MM.yyyy");

    private static string Percent(int? p) => p is { } v ? $"{v}%" : "—";

    private static MarkupString PercentChip(int? p) => p is { } v
        ? new MarkupString($"<span class=\"tc-exam {(v >= 70 ? "good" : v >= 40 ? "mid" : "low")}\"><b>{v}%</b></span>")
        : new MarkupString("<span class=\"te-none\">—</span>");
}
