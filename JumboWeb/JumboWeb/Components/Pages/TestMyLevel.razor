@page "/test-my-level"
@rendermode InteractiveServer
@using JumboWeb.Services
@inject AppLocalizer Loc
@inject NavigationManager Nav

<PageTitle>@Loc["SiteLayout_TestNav"]</PageTitle>

<div class="exam-page">
    <header class="exam-hero">
        <Tiger Head="true" Mood="idle" Size="76" />
        <div class="exam-hero-text">
            <h1 class="exam-title">@Loc["Placement_Title"]</h1>
            <p class="exam-intro">@Loc["Placement_Intro"]</p>
        </div>
    </header>

    <section class="exam-card">
        <h2 class="exam-step">@Loc["Placement_Parts"]</h2>
        <ul class="pl-parts">
            <li><span aria-hidden="true">🖼️</span> @Loc["Placement_PartVocab"]</li>
            <li><span aria-hidden="true">✏️</span> @Loc["Placement_PartGrammar"]</li>
            <li><span aria-hidden="true">📖</span> @Loc["Placement_PartReading"]</li>
            <li><span aria-hidden="true">🎧</span> @Loc["Placement_PartListening"]</li>
        </ul>
        <p class="exam-note">@Loc["Placement_HowTo"]</p>
        <p class="exam-note">@Loc["Placement_LevelsNote"]</p>
    </section>

    <button type="button" class="lp-btn lp-btn-full" @onclick='() => Nav.NavigateTo("/test-my-level/quiz")'>@Loc["Placement_Start"] →</button>
</div>
