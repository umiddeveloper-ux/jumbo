@page "/teacher/reports"
@rendermode InteractiveServer
@using JumboWeb.Services
@using Jumbo.Shared.Dtos
@using Jumbo.Shared.Entities
@inject LpApiClient ApiClient
@inject UserStateService UserState
@inject AppLocalizer Loc
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@Loc["Nav_Reports"]</PageTitle>

@* "Reports" of a teacher / director: the teams as on the home page (a click opens the report of the team), and below them the common report of all the teams. *@
@if (!_loaded)
{
    <div class="lp-spinner-wrap">@Loc["Common_Loading"]</div>
}
else
{
    <div class="tc">
        <h1 class="tc-title rp-noprint">📊 @Loc["Nav_Reports"]</h1>
        @if (!string.IsNullOrEmpty(UserState.CurrentUser?.School))
        {
            <p class="tc-school rp-noprint">🏫 @UserState.CurrentUser!.School</p>
        }

        @if (_noSchool)
        {
            <div class="lp-empty-state">@Loc["TC_NoSchool"]</div>
        }
        else if (_classes.Count == 0)
        {
            <div class="tc-empty">
                <Tiger Mood="wave" Size="120" />
                <p>@Loc["TC_NoClasses"]</p>
            </div>
        }
        else
        {
            <p class="tc-hint rp-noprint">@Loc["RP_PickTeam"]</p>
            <div class="tc-grid rp-noprint">
                @foreach (var cls in _classes)
                {
                    <a class="tc-class @(cls.IsArchived ? "archived" : "")" href="/teacher/class/@cls.ClassId/report">
                        <div class="tc-class-head">
                            <span class="tc-class-name">@cls.Name</span>
                            @if (cls.IsArchived)
                            {
                                <span class="tc-badge">@Loc["TC_Archived"]</span>
                            }
                        </div>
                        @if (IsDirector && !string.IsNullOrEmpty(cls.TeacherName))
                        {
                            <div class="tc-class-teacher">@Loc.Format("TC_Teacher", cls.TeacherName)</div>
                        }
                        <div class="tc-stats">
                            <div class="tc-stat"><b>@cls.StudentCount</b><span>@Loc["TC_Students"]</span></div>
                            <div class="tc-stat"><b>@cls.ActiveWeek</b><span>@Loc["TC_Active"]</span></div>
                            <div class="tc-stat"><b>@(cls.AvgExamPercent is { } p ? $"{p}%" : "—")</b><span>@Loc["TC_AvgExam"]</span></div>
                        </div>
                    </a>
                }
            </div>

            @if (_r is not null)
            {
                var t = _r.Totals;
                <div class="rp">
                    <header class="rp-head">
                        <div>
                            <h1 class="rp-title">📊 @Loc["RP_AllTeamsTitle"]</h1>
                            <p class="rp-sub">🏫 @_r.SchoolName</p>
                            <p class="rp-sub">@Fmt(_r.Period.From) – @Fmt(_r.Period.To) · @Loc["RP_VsPrev"] @Fmt(_r.Period.PrevFrom) – @Fmt(_r.Period.PrevTo)</p>
                        </div>
                        <div class="rp-tools rp-noprint">
                            <div class="rate-period">
                                <button type="button" class="rate-chip @(_period == "week" ? "on" : "")" @onclick='() => SetPeriodAsync("week")'>@Loc["RP_Week"]</button>
                                <button type="button" class="rate-chip @(_period == "month" ? "on" : "")" @onclick='() => SetPeriodAsync("month")'>@Loc["RP_Month"]</button>
                            </div>
                            <button type="button" class="lp-btn lp-btn-sm lp-btn-outline" @onclick="Print">🖨 @Loc["RP_Print"]</button>
                        </div>
                    </header>

                    <div class="rp-kpis">
                        <ReportKpi Label="@Loc["RP_Students"]" Value="@t.Students.ToString()" />
                        <ReportKpi Label="@Loc["RP_Active"]" Value="@($"{t.Active}/{t.Students}")" Delta="@(t.Active - t.ActivePrev)" Hint="@Loc["RP_VsPrev"]" />
                        <ReportKpi Label="@Loc["RP_Words"]" Value="@t.Words.ToString()" Delta="@(t.Words - t.WordsPrev)" Hint="@Loc["RP_VsPrev"]" />
                        <ReportKpi Label="@Loc["RP_Exams"]" Value="@t.ExamCount.ToString()" Delta="@(t.ExamCount - t.ExamCountPrev)" Hint="@Loc["RP_VsPrev"]" />
                        <ReportKpi Label="@Loc["RP_AvgExam"]" Value="@(t.AvgExamPercent is { } a ? $"{a}%" : "—")"
                                   Delta="@(t.AvgExamPercent is { } c && t.AvgExamPercentPrev is { } pp ? c - pp : null)" Suffix="%" Hint="@Loc["RP_VsPrev"]" />
                    </div>

                    <section class="rp-card">
                        <h2 class="rp-h2">@Loc["RP_Teams"]</h2>
                        @if (_r.Teams.Count == 0)
                        {
                            <p class="rp-note">@Loc["RP_NoTeams"]</p>
                        }
                        else
                        {
                            <div class="tc-table rp-table rp-teams">
                                <div class="tc-row tc-row-head">
                                    <div>@Loc["RP_ColTeam"]</div>
                                    <div>@Loc["RP_Students"]</div>
                                    <div>@Loc["RP_Active"]</div>
                                    <div>@Loc["RP_ColWords"]</div>
                                    <div>@Loc["RP_Exams"]</div>
                                    <div>@Loc["RP_AvgExam"]</div>
                                </div>
                                @foreach (var team in _r.Teams)
                                {
                                    var x = team.Totals;
                                    <div class="tc-row rp-row">
                                        <div class="tc-cell-name">
                                            <span>
                                                <a class="tc-name-link" href="/teacher/class/@team.ClassId/report">@team.TeamName</a>
                                                @if (IsDirector && !string.IsNullOrEmpty(team.TeacherName)) { <small class="tc-login">@team.TeacherName</small> }
                                            </span>
                                        </div>
                                        <div data-label="@Loc["RP_Students"]">@x.Students</div>
                                        <div data-label="@Loc["RP_Active"]">@x.Active/@x.Students @Trend(x.Active - x.ActivePrev)</div>
                                        <div data-label="@Loc["RP_ColWords"]">@x.Words @Trend(x.Words - x.WordsPrev)</div>
                                        <div data-label="@Loc["RP_Exams"]">@x.ExamCount</div>
                                        <div data-label="@Loc["RP_AvgExam"]">
                                            @if (x.AvgExamPercent is { } ap)
                                            {
                                                <span class="tc-exam @ExamClass(ap)">@ap%</span>
                                            }
                                            else
                                            {
                                                <span class="tc-muted">—</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </section>

                    <p class="rp-foot">@Loc["RP_Scope"] · @Loc.Format("RP_Generated", _r.GeneratedAt.AddHours(5).ToString("dd.MM.yyyy HH:mm")) · Jumbo.uz</p>
                </div>
            }
        }
    </div>
}

@code {
    private bool _loaded, _noSchool;
    private string _period = "week";
    private List<ClassDto> _classes = new();
    private SchoolReportDto? _r;

    private bool IsDirector => UserState.CurrentUser?.Role == UserRole.Director;

    protected override async Task OnInitializedAsync()
    {
        await UserState.EnsureLoadedAsync();
        if (UserState.CurrentUser?.Role is not (UserRole.Teacher or UserRole.Director))
        {
            Nav.NavigateTo("/for-schools", replace: true);
            return;
        }

        try
        {
            _classes = (await ApiClient.TeacherGetClassesAsync()).OrderBy(c => c.IsArchived).ThenBy(c => c.Name).ToList();
            if (_classes.Count > 0) _r = await ApiClient.TeacherGetTeamsReportAsync(_period);
        }
        catch (Exception) { _noSchool = true; }
        _loaded = true;
    }

    private async Task SetPeriodAsync(string period)
    {
        _period = period;
        _r = await ApiClient.TeacherGetTeamsReportAsync(_period) ?? _r;
    }

    private async Task Print() => await JS.InvokeVoidAsync("lp.printPage");

    private static string Fmt(DateOnly d) => d.ToString("dd.MM.yyyy");

    private static MarkupString Trend(int delta) =>
        delta == 0 ? new MarkupString("") :
        new MarkupString($"<small class=\"rp-trend {(delta > 0 ? "up" : "down")}\">{(delta > 0 ? "▲" : "▼")}{Math.Abs(delta)}</small>");

    private static string ExamClass(int percent) => percent >= 70 ? "good" : percent >= 40 ? "mid" : "low";
}
