    /// <summary>The section of the page (the left menu of the admin): requests, schools, subscribers, versions, plans, videos.</summary>
    [Parameter] public string? Section { get; set; }

    private static readonly string[] Sections = ["requests", "schools", "subscribers", "versions", "plans", "prices", "balance", "ads", "videos"];

    private string SectionLabel => _tab switch
    {
        "schools" => "Admin_TabSchools", "subscribers" => "Admin_TabSubscribers", "versions" => "Admin_TabVersions",
        "plans" => "Admin_TabPlans", "videos" => "Admin_TabVideos", "prices" => "Admin_TabPrices", "balance" => "Admin_TabBalance", "ads" => "Admin_TabAds", _ => "Admin_TabRequests"
    };

    private string SectionIcon => _tab switch
    {
        "schools" => "🏫", "subscribers" => "💬", "versions" => "📱", "plans" => "🪙", "videos" => "🎬", "prices" => "🏷", "balance" => "💳", "ads" => "📣", _ => "📨"
    };

    protected override async Task OnParametersSetAsync()
    {
        await UserState.EnsureLoadedAsync();
        // Pages are also protected by the API (Admin role); this keeps everybody else out of the UI.
        if (UserState.CurrentUser?.Role != UserRole.Admin)
        {
            Nav.NavigateTo("/", replace: true);
            return;
        }

        // "/admin" is the first section
        if (string.IsNullOrEmpty(Section)) { Nav.NavigateTo("/admin/requests", replace: true); return; }
        var tab = Sections.Contains(Section) ? Section : "requests";
        if (_loaded && tab == _tab) return;

        await SetTabAsync(tab);
        _loaded = true;
    }

    private async Task SetTabAsync(string tab)
    {
        _tab = tab;
        _message = _error = string.Empty;
        if (tab == "requests") await LoadRequestsAsync();
        else if (tab == "videos") await LoadVideosAsync();
        else if (tab == "ads") { _adForm = null; _adPreview = false; try { _ads = await ApiClient.AdminGetAdsAsync(); } catch (Exception ex) { _error = ex.Message; } }
        else if (tab == "prices") { try { _priceRows = await ApiClient.GetPlanPricesAsync(); } catch (Exception ex) { _error = ex.Message; } }
        else if (tab == "balance") { try { _balanceTx = await ApiClient.AdminGetBalanceTransactionsAsync(); } catch (Exception ex) { _error = ex.Message; } }
        else if (tab == "plans") { try { _planUsers = await ApiClient.AdminGetPlansAsync(); } catch (Exception ex) { _error = ex.Message; } }
        else if (tab == "versions") { try { _versions = await ApiClient.AdminGetAppVersionsAsync(); } catch (Exception ex) { _error = ex.Message; } }
        else if (tab == "subscribers") { try { _subscribers = await ApiClient.AdminGetSubscribersAsync(); _feedback = await ApiClient.AdminGetFeedbackAsync(); } catch (Exception ex) { _error = ex.Message; } }
        else await LoadSchoolsAsync();
    }

    private static string VideoLangName(string code) => code switch { "ru" => "Русский", "uz" => "O'zbekcha", "tr" => "Türkçe", _ => "English" };

    private static string FormatSize(long bytes) => bytes >= 1024 * 1024 ? $"{bytes / 1048576.0:0.#} MB" : $"{Math.Max(1, bytes / 1024)} KB";

    private async Task LoadVideosAsync()
    {
        try
        {
            _vSubjects = (await ApiClient.GetSubjectsByBookAsync(_vBook)).OrderBy(s => s.SequenceNumber).ToList();
            _vFiles = Videos.Book(_vLang, _vBook);
            if (_vSeq == 0 || _vSubjects.All(s => s.SequenceNumber != _vSeq)) _vSeq = _vSubjects.FirstOrDefault()?.SequenceNumber ?? 0;
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task OnVideoLangChanged(ChangeEventArgs e) { _vLang = e.Value?.ToString() ?? "en"; await LoadVideosAsync(); }
    private async Task OnVideoBookChanged(ChangeEventArgs e) { _vBook = int.TryParse(e.Value?.ToString(), out var b) ? b : 1; _vSeq = 0; await LoadVideosAsync(); }

    private void OnVideoPicked(InputFileChangeEventArgs e) { _vFile = e.File; _message = _error = string.Empty; }

    private async Task UploadVideoAsync()
    {
        if (_vFile is null || _vSeq == 0) return;
        _message = _error = string.Empty;
        if (!_vFile.Name.EndsWith(".mp4", StringComparison.OrdinalIgnoreCase)) { _error = Loc["VD_Err_NOT_MP4"]; return; }
        if (_vFile.Size > TopicVideoStore.MaxBytes) { _error = Loc["VD_Err_TOO_BIG"]; return; }

        _vBusy = true;
        _vSent = 0;
        try
        {
            await using var stream = _vFile.OpenReadStream(TopicVideoStore.MaxBytes);
            await Videos.SaveAsync(_vLang, _vBook, _vSeq, stream, sent => { _vSent = sent; _ = InvokeAsync(StateHasChanged); });
            _message = Loc.Format("VD_Saved", VideoLangName(_vLang), _vBook, _vSeq);
            _vFile = null;
            _vFiles = Videos.Book(_vLang, _vBook);
        }
        catch (InvalidDataException ex) { _error = Loc[$"VD_Err_{ex.Message}"]; }
        catch (Exception ex) { _error = ex.Message; }
        finally { _vBusy = false; }
    }

    private async Task DeleteVideoAsync(int seq)
    {
        if (!await JS.InvokeAsync<bool>("confirm", Loc.Format("VD_ConfirmDelete", VideoLangName(_vLang), _vBook, seq))) return;
        try { Videos.Delete(_vLang, _vBook, seq); _vFiles = Videos.Book(_vLang, _vBook); _message = Loc["VD_Deleted"]; }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task SavePlanAsync()
