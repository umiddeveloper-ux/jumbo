@page "/admin"
@page "/admin/{Section}"
@rendermode InteractiveServer
@using JumboWeb.Services
@using Jumbo.Shared.Entities
@inject LpApiClient ApiClient
@inject UserStateService UserState
@inject AppLocalizer Loc
@inject NavigationManager Nav
@inject TopicVideoStore Videos
@inject IJSRuntime JS

<PageTitle>@Loc["Admin_Title"]</PageTitle>

@if (!_loaded)
{
    <div class="lp-spinner-wrap">@Loc["Common_Loading"]</div>
}
else
{
    <div class="adm">
        <h1 class="adm-title">@SectionIcon @Loc[SectionLabel]</h1>

        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="lp-success-msg">@_message</div>
        }
        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="validation-message">@_error</p>
        }

        @if (_tab == "requests")
        {
            <div class="rate-period adm-status">
                @foreach (var (key, label) in Statuses)
                {
                    var k = key;
                    <button type="button" class="rate-chip @(_status == k ? "on" : "")" @onclick="() => SetStatusAsync(k)">@Loc[label]</button>
                }
            </div>

            @if (_requests.Count == 0)
            {
                <div class="lp-empty-state">@Loc["Admin_Empty"]</div>
            }
            @foreach (var r in _requests)
            {
                var req = r;
                <article class="adm-card">
                    <div class="adm-card-head">
                        <div>
                            <div class="adm-name">@(req.ApplicantName ?? "—") <span class="adm-login">@@@req.ApplicantLogin</span></div>
                            <div class="adm-meta">
                                <span class="adm-badge @(req.Role == UserRole.Director ? "dir" : "tea")">@Loc[$"Role_{req.Role}"]</span>
                                @Loc[$"Region_{req.Region}"] · @req.CreatedAt.ToString("yyyy-MM-dd")
                            </div>
                        </div>
                        <span class="adm-state @req.Status.ToString().ToLowerInvariant()">@req.Status</span>
                    </div>

                    <div class="adm-row"><b>@Loc["Admin_Typed"]:</b> @req.SchoolName</div>
                    @if (!string.IsNullOrEmpty(req.Phone)) { <div class="adm-row">📞 @req.Phone</div> }
                    @if (!string.IsNullOrEmpty(req.Comment)) { <div class="adm-row">💬 @req.Comment</div> }
                    @if (!string.IsNullOrEmpty(req.AdminNote)) { <div class="adm-row muted">📝 @req.AdminNote</div> }

                    @if (req.Status == StaffRequestStatus.Pending)
                    {
                        @if (_deciding == req.Id)
                        {
                            <div class="adm-decide">
                                @if (_decision == "approve")
                                {
                                    <div class="settings-label">@Loc["Admin_ChooseSchool"]</div>
                                    <select class="lp-select" @bind="_chosenSchool">
                                        <option value="0">➕ @Loc["Admin_CreateNew"]</option>
                                        @foreach (var s in _regionSchools)
                                        {
                                            <option value="@s.SchoolId">@s.Name @(s.IsVerified ? "✓" : "")</option>
                                        }
                                    </select>
                                    @if (_chosenSchool == 0)
                                    {
                                        <div class="settings-label">@Loc["Admin_NewName"]</div>
                                        <input class="lp-input" type="text" maxlength="150" @bind="_newSchoolName" @bind:event="oninput" />
                                    }
                                }
                                <div class="settings-label">@Loc["Admin_Note"]</div>
                                <input class="lp-input" type="text" maxlength="500" @bind="_note" @bind:event="oninput" />
                                <div class="adm-actions">
                                    <button type="button" class="lp-btn lp-btn-sm @(_decision == "reject" ? "adm-danger" : "")" disabled="@_busy" @onclick="() => ConfirmAsync(req)">@Loc["Admin_Confirm"]</button>
                                    <button type="button" class="lp-btn lp-btn-sm lp-btn-outline" @onclick="() => _deciding = 0">@Loc["Common_Cancel"]</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="adm-actions">
                                <button type="button" class="lp-btn lp-btn-sm" @onclick='() => StartDecisionAsync(req, "approve")'>✓ @Loc["Admin_Approve"]</button>
                                <button type="button" class="lp-btn lp-btn-sm lp-btn-outline" @onclick='() => StartDecisionAsync(req, "reject")'>✕ @Loc["Admin_Reject"]</button>
                            </div>
                        }
                    }
                </article>
            }
        }
        else if (_tab == "videos")
        {
            <p class="reg-help">@Loc["VD_Hint"]</p>
            <section class="adm-card">
                <div class="adm-ver-grid">
                    <label>@Loc["VD_Lang"]
                        <select class="lp-select" value="@_vLang" @onchange="OnVideoLangChanged">
                            @foreach (var l in Jumbo.Shared.TopicVideoPaths.Languages)
                            {
                                <option value="@l">@VideoLangName(l)</option>
                            }
                        </select>
                    </label>
                    <label>@Loc["VD_Book"]
                        <select class="lp-select" value="@_vBook" @onchange="OnVideoBookChanged">
                            @for (var b = 1; b <= Jumbo.Shared.Course.BookCount; b++)
                            {
                                <option value="@b">@Loc.Format("TE_BookCol", b)</option>
                            }
                        </select>
                    </label>
                </div>
                <label>@Loc["VD_Topic"]
                    <select class="lp-select" @bind="_vSeq">
                        @foreach (var s in _vSubjects)
                        {
                            <option value="@s.SequenceNumber">@s.SequenceNumber. @s.SubjectName@(_vFiles.ContainsKey(s.SequenceNumber) ? " ✓" : "")</option>
                        }
                    </select>
                </label>
                <label>@Loc["VD_File"]
                    <InputFile class="lp-input" accept="video/mp4,.mp4" OnChange="OnVideoPicked" />
                </label>
                @if (_vFile is not null)
                {
                    <p class="reg-help">🎞 @_vFile.Name · @FormatSize(_vFile.Size)@(_vFile.Size > 60L * 1024 * 1024 ? " · " + Loc["VD_Big"] : "")@(_vFiles.ContainsKey(_vSeq) ? " · " + Loc["VD_WillReplace"] : "")</p>
                }
                @if (_vBusy)
                {
                    <div class="adm-progress"><div style="width:@(_vFile is { Size: > 0 } ? Math.Min(100, _vSent * 100 / _vFile.Size) : 0)%"></div></div>
                    <p class="reg-help">@Loc["VD_Uploading"] @FormatSize(_vSent)</p>
                }
                <button type="button" class="lp-btn lp-btn-sm" disabled="@(_vBusy || _vFile is null || _vSeq == 0)" @onclick="UploadVideoAsync">⬆ @Loc["VD_Upload"]</button>
                @* the answer is shown here as well: the list below is long and the page above is out of sight *@
                @if (!string.IsNullOrEmpty(_message)) { <div class="lp-success-msg">@_message</div> }
                @if (!string.IsNullOrEmpty(_error)) { <p class="validation-message">@_error</p> }
            </section>

            <section class="adm-card">
                <div class="settings-label">@Loc.Format("VD_Status", VideoLangName(_vLang), _vBook, _vFiles.Count, _vSubjects.Count)</div>
                @foreach (var s in _vSubjects)
                {
                    var seq = s.SequenceNumber;
                    <div class="adm-row">
                        <b>@seq.</b> <span>@s.SubjectName</span>
                        @if (_vFiles.TryGetValue(seq, out var info))
                        {
                            <span class="reg-help">✓ @FormatSize(info.Size) · @info.ModifiedUtc.AddHours(5).ToString("dd.MM.yyyy")</span>
                            <a class="lp-btn lp-btn-sm lp-btn-outline" target="_blank" href="@Jumbo.Shared.TopicVideoPaths.Url(_vLang, _vBook, seq)">▶ @Loc["VD_Watch"]</a>
                            <button type="button" class="lp-btn lp-btn-sm lp-btn-outline" @onclick="() => _vSeq = seq">@Loc["VD_Replace"]</button>
                            <button type="button" class="lp-btn lp-btn-sm lp-btn-outline" @onclick="() => DeleteVideoAsync(seq)">🗑</button>
                        }
                        else
                        {
                            <span class="reg-help">— @Loc["VD_None"]</span>
                            <button type="button" class="lp-btn lp-btn-sm lp-btn-outline" @onclick="() => _vSeq = seq">⬆ @Loc["VD_Upload"]</button>
                        }
                    </div>
                }
            </section>
        }
        else if (_tab == "ads")
        {
            <p class="reg-help">@Loc["Admin_Ad_Hint"]</p>

            @if (_adForm is null)
            {
                <button type="button" class="lp-btn lp-btn-sm" @onclick="() => NewAd()">➕ @Loc["Admin_Ad_New"]</button>
                @if (_ads.Count == 0)
                {
                    <p class="reg-help">@Loc["Admin_Ad_Empty"]</p>
                }
                @foreach (var ad in _ads)
                {
                    var a = ad;
                    <section class="adm-card adm-ad @(a.IsActive ? "" : "off")">
                        <div class="adm-ad-head">
                            <b>@a.Title</b>
                            <span class="adm-badge">@(a.IsActive ? Loc["Admin_Ad_On"] : Loc["Admin_Ad_Off"])</span>
                            @if (a.Lang is not null) { <span class="adm-badge">@a.Lang.ToUpperInvariant()</span> }
                            @if (a.HasImage) { <span class="adm-badge">🖼</span> }
                        </div>
                        <div class="reg-help">@AdSummary(a)</div>
                        <div class="reg-help">@Loc.Format("Admin_Ad_Stats", a.Viewers, a.Showings)@(a.LastShownAt is { } last ? " · " + last.AddHours(5).ToString("dd.MM.yyyy HH:mm") : " · " + Loc["Admin_Ad_Never"])</div>
                        <div class="adm-ad-actions">
                            <button type="button" class="lp-btn lp-btn-sm lp-btn-outline" @onclick="() => EditAdAsync(a.Id)">✏️ @Loc["Admin_Ad_Edit"]</button>
                            <button type="button" class="lp-btn lp-btn-sm lp-btn-outline" @onclick="() => ResetAdAsync(a.Id)">🔁 @Loc["Admin_Ad_Reset"]</button>
                            <button type="button" class="lp-btn lp-btn-sm lp-btn-outline" @onclick="() => DeleteAdAsync(a)">🗑 @Loc["Admin_Ad_Delete"]</button>
                        </div>
                    </section>
                }
            }
            else
            {
                var f = _adForm;
                <section class="adm-card">
                    <label>@Loc["Admin_Ad_Title"]<input class="lp-input" type="text" maxlength="200" @bind="f.Title" @bind:event="oninput" /></label>
                    <div class="adm-ad-texthead">
                        <span class="settings-label">@Loc["Admin_Ad_Text"]</span>
                        <button type="button" class="lp-btn lp-btn-sm lp-btn-outline" @onclick="ToggleAdSource">@(_adSource ? "✏️ " + Loc["Admin_Ad_Visual"] : "</> " + Loc["Admin_Ad_HtmlSource"])</button>
                    </div>
                    @if (_adSource)
                    {
                        <textarea class="lp-input adm-ad-html" rows="9" maxlength="8000" @bind="f.Html" @bind:event="oninput"></textarea>
                        <p class="reg-help">@Loc["Admin_Ad_TextHint"]</p>
                    }
                    else
                    {
                        @* the visual editor (Quill) lives in this block; the page does not draw inside it *@
                        <div class="adm-editor-wrap"><div id="ad-editor"></div></div>
                    }

                    <div class="settings-label">@Loc["Admin_Ad_Image"]</div>
                    @if (!string.IsNullOrEmpty(f.ImageDataUrl))
                    {
                        <img class="adm-ad-thumb" src="@f.ImageDataUrl" alt="" />
                        <button type="button" class="lp-btn lp-btn-sm lp-btn-outline" @onclick="() => { f.ImageDataUrl = null; f.RemoveImage = true; }">✖ @Loc["Admin_Ad_ImageRemove"]</button>
                    }
                    <InputFile class="lp-input" accept="image/png,image/jpeg,image/webp,image/gif" OnChange="OnAdImagePicked" />

                    <div class="settings-label">@Loc["Admin_Ad_Mode"]</div>
                    <label class="adm-radio"><input type="radio" name="admode" checked="@(f.Mode == "fixed")" @onchange='() => f.Mode = "fixed"' /> @Loc["Admin_Ad_ModeFixed"]</label>
                    <label class="adm-radio"><input type="radio" name="admode" checked="@(f.Mode == "periodic")" @onchange='() => f.Mode = "periodic"' /> @Loc["Admin_Ad_ModePeriodic"]</label>
                    <label class="adm-radio"><input type="radio" name="admode" checked="@(f.Mode == "daily")" @onchange='() => f.Mode = "daily"' /> @Loc["Admin_Ad_ModeDaily"]</label>

                    <div class="adm-ver-grid">
                        <label>@Loc["Admin_Ad_Starts"]<input class="lp-input" type="datetime-local" @bind="f.StartsLocal" /></label>
                        <label>@Loc["Admin_Ad_Ends"]<input class="lp-input" type="datetime-local" @bind="f.EndsLocal" /></label>
                    </div>
                    @if (f.Mode == "daily")
                    {
                        <label>@Loc["Admin_Ad_DailyAt"]<input class="lp-input" type="time" @bind="f.DailyTime" /></label>
                    }
                    @if (f.Mode == "periodic")
                    {
                        <div class="adm-ver-grid">
                            <label>@Loc["Admin_Ad_Every"]<input class="lp-input" type="number" min="1" @bind="f.IntervalValue" /></label>
                            <label>&nbsp;
                                <select class="lp-select" @bind="f.IntervalUnit">
                                    <option value="min">@Loc["Admin_Ad_Minutes"]</option>
                                    <option value="hour">@Loc["Admin_Ad_Hours"]</option>
                                    <option value="day">@Loc["Admin_Ad_Days"]</option>
                                </select>
                            </label>
                        </div>
                    }
                    <label>@Loc["Admin_Ad_Lang"]
                        <select class="lp-select" @bind="f.Lang">
                            <option value="">@Loc["Admin_Ad_LangAll"]</option>
                            <option value="ru">Русский</option>
                            <option value="en">English</option>
                            <option value="uz">O'zbekcha</option>
                        </select>
                    </label>
                    <label class="adm-radio"><input type="checkbox" @bind="f.IsActive" /> @Loc["Admin_Ad_Active"]</label>

                    <div class="adm-ad-actions">
                        <button type="button" class="lp-btn lp-btn-sm" disabled="@_busy" @onclick="SaveAdAsync">💾 @Loc["Admin_Ad_Save"]</button>
                        <button type="button" class="lp-btn lp-btn-sm lp-btn-outline" @onclick="() => _adPreview = true">👁 @Loc["Admin_Ad_Preview"]</button>
                        <button type="button" class="lp-btn lp-btn-sm lp-btn-outline" @onclick="() => _adForm = null">@Loc["Admin_Ad_Cancel"]</button>
                    </div>
                    @if (!string.IsNullOrEmpty(_message)) { <div class="lp-success-msg">@_message</div> }
                    @if (!string.IsNullOrEmpty(_error)) { <p class="validation-message">@_error</p> }
                </section>
                @if (_adPreview)
                {
                    <AdDialog Title="@f.Title" Html="@f.Html" ImageDataUrl="@f.ImageDataUrl" OnClose="() => _adPreview = false" />
                }
            }
        }
        else if (_tab == "prices")
        {
            <p class="reg-help">@Loc["PR_Hint"]</p>
            <section class="adm-card">
                @foreach (var plan in new[] { Jumbo.Shared.Plans.Silver, Jumbo.Shared.Plans.Gold })
                {
                    var p = plan;
                    <div class="settings-label"><span class="plan-coin plan-@p pp-coin" style="width:22px;height:22px;font-size:.8rem;display:inline-flex;vertical-align:middle">★</span> @Loc[JumboWeb.Components.Pages.PlansPage.PlanKey(p)]</div>
                    <div class="adm-ver-grid">
                        <label>@Loc["PP_Monthly"] (@Loc["Money_Currency"])<input class="lp-input" type="number" min="0" step="1000" placeholder="0" @bind="PriceRef(p, Jumbo.Shared.Plans.Month).Amount" /></label>
                        <label>@Loc["PP_Yearly"] (@Loc["Money_Currency"])<input class="lp-input" type="number" min="0" step="1000" placeholder="0" @bind="PriceRef(p, Jumbo.Shared.Plans.Year).Amount" /></label>
                    </div>
                }
                <button type="button" class="lp-btn lp-btn-sm" disabled="@_busy" @onclick="SavePricesAsync">@Loc["PR_Save"]</button>
            </section>
        }
        else if (_tab == "balance")
        {
            <p class="reg-help">@Loc["BA_Hint"]</p>
            <section class="adm-card">
                <label>@Loc["PA_User"]<input class="lp-input" type="text" maxlength="60" @bind="_topUser" @bind:event="oninput" placeholder="A0000001" /></label>
                <div class="adm-ver-grid">
                    <label>@Loc["BA_Amount"] (@Loc["Money_Currency"])<input class="lp-input" type="number" min="1" step="1000" @bind="_topAmount" /></label>
                    <label>@Loc["BA_Note"]<input class="lp-input" type="text" maxlength="200" @bind="_topNote" /></label>
                </div>
                <button type="button" class="lp-btn lp-btn-sm" disabled="@_busy" @onclick="TopUpAsync">💳 @Loc["BA_Do"]</button>
                @if (!string.IsNullOrEmpty(_message)) { <div class="lp-success-msg">@_message</div> }
                @if (!string.IsNullOrEmpty(_error)) { <p class="validation-message">@_error</p> }
            </section>
            <section class="adm-card">
                <div class="settings-label">@Loc["BA_History"]</div>
                @foreach (var t in _balanceTx)
                {
                    <div class="adm-row">
                        <span class="reg-help">@t.CreatedAt.AddHours(5).ToString("dd.MM.yyyy HH:mm")</span>
                        <b>@t.PublicId</b> <span>@t.UserName</span>
                        <span class="reg-help">@(t.Kind == "purchase" ? "🛒 " + t.Note : "💳 " + (t.Provider ?? "") + (string.IsNullOrEmpty(t.Note) ? "" : " · " + t.Note))</span>
                        <b>@(t.Amount > 0 ? "+" : "")@Jumbo.Shared.Money.Format(t.Amount)</b>
                    </div>
                }
            </section>
        }
        else if (_tab == "plans")
        {
            <p class="reg-help">@Loc["PA_Hint"]</p>
            <section class="adm-card">
                <label>@Loc["PA_User"]<input class="lp-input" type="text" maxlength="60" @bind="_planUser" @bind:event="oninput" /></label>
                <div class="adm-ver-grid">
                    <label>@Loc["PA_Plan"]
                        <select class="lp-select" @bind="_planKind">
                            @foreach (var p in Jumbo.Shared.Plans.All)
                            {
                                <option value="@p">@Loc[JumboWeb.Components.Pages.PlansPage.PlanKey(p)]</option>
                            }
                        </select>
                    </label>
                    <label>@Loc["PA_Until"]<input class="lp-input" type="date" @bind="_planUntil" /></label>
                </div>
                <button type="button" class="lp-btn lp-btn-sm" disabled="@_busy" @onclick="SavePlanAsync">@Loc["PA_Save"]</button>
            </section>
            <section class="adm-card">
                <div class="settings-label">@Loc.Format("PA_List", _planUsers.Count)</div>
                @foreach (var u in _planUsers)
                {
                    <div class="adm-row">
                        <span class="plan-coin plan-@u.Plan pp-coin" style="width:22px;height:22px;font-size:.8rem">★</span>
                        <b>@u.Name</b> <span class="reg-help">@u.PublicId · @u.Username</span>
                        <span>@Loc[JumboWeb.Components.Pages.PlansPage.PlanKey(u.Plan)]@(u.PlanUntil is { } d ? " · " + d.ToLocalTime().ToString("dd.MM.yyyy") : "")</span>
                    </div>
                }
            </section>
        }
        else if (_tab == "versions")
        {
            <p class="reg-help">@Loc["Ver_Hint"]</p>
            @foreach (var v in _versions)
            {
                var ver = v;
                <section class="adm-card">
                    <div class="settings-label">@(ver.Platform == "android" ? "🤖 Android" : ver.Platform == "ios" ? "🍎 iOS" : "🪟 Windows")</div>
                    <div class="adm-ver-grid">
                        <label>@Loc["Ver_Latest"]<input class="lp-input" type="number" min="0" @bind="ver.LatestCode" /></label>
                        <label>@Loc["Ver_Min"]<input class="lp-input" type="number" min="0" @bind="ver.MinCode" /></label>
                    </div>
                    <label>@Loc["Ver_Url"]<input class="lp-input" type="text" maxlength="500" placeholder="https://play.google.com/store/apps/details?id=uz.jumbo.app" @bind="ver.Url" /></label>
                    <label>@Loc["Ver_NotesRu"]<input class="lp-input" type="text" maxlength="500" @bind="ver.NotesRu" /></label>
                    <label>@Loc["Ver_NotesEn"]<input class="lp-input" type="text" maxlength="500" @bind="ver.NotesEn" /></label>
                    <label>@Loc["Ver_NotesUz"]<input class="lp-input" type="text" maxlength="500" @bind="ver.NotesUz" /></label>
                    <button type="button" class="lp-btn lp-btn-sm" disabled="@_busy" @onclick="() => SaveVersionAsync(ver)">@Loc["Ver_Save"]</button>
                </section>
            }
        }
        else if (_tab == "subscribers")
        {
            <section class="adm-card">
                <div class="settings-label">@Loc["Admin_FeedbackTitle"]: @_feedback.Count</div>
                @foreach (var f in _feedback)
                {
                    <article class="adm-msg">
                        <div class="adm-msg-head"><b>@f.Email</b> <small>@f.Lang.ToUpperInvariant() · @f.CreatedAt.ToString("yyyy-MM-dd HH:mm")</small></div>
                        <p>@f.Message</p>
                    </article>
                }
            </section>
            <section class="adm-card">
                <div class="settings-label">@Loc.Format("Admin_SubscribersCount", _subscribers.Count)</div>
                @if (_subscribers.Count == 0)
                {
                    <div class="lp-empty-state">@Loc["Admin_Empty"]</div>
                }
                else
                {
                    <textarea class="lp-input" readonly rows="6" onclick="this.select()">@string.Join("; ", _subscribers.Select(x => x.Email))</textarea>
                    <ul class="adm-subs">
                        @foreach (var x in _subscribers)
                        {
                            <li><span>@x.Email</span> <small>@x.Lang.ToUpperInvariant() · @x.CreatedAt.ToString("yyyy-MM-dd HH:mm")</small></li>
                        }
                    </ul>
                }
            </section>
        }
        else
        {
            <section class="adm-card">
                <div class="settings-label">@Loc["Admin_AddSchool"]</div>
                <div class="adm-add">
                    <select class="lp-select" @bind="_addRegion">
                        <option value="">@Loc["Reg_RegionPlaceholder"]</option>
                        @foreach (var rc in UzRegions.Codes)
                        {
                            <option value="@rc">@Loc[$"Region_{rc}"]</option>
                        }
                    </select>
                    <input class="lp-input" type="text" maxlength="150" placeholder="@Loc["Reg_SchoolPlaceholder"]" @bind="_addName" @bind:event="oninput" />
                    <button type="button" class="lp-btn lp-btn-sm" disabled="@_busy" @onclick="AddSchoolAsync">＋</button>
                </div>
            </section>

            <select class="lp-select adm-filter" value="@_schoolRegion" @onchange="OnSchoolRegionChanged">
                <option value="">@Loc["Admin_AllRegions"]</option>
                @foreach (var rc in UzRegions.Codes)
                {
                    <option value="@rc">@Loc[$"Region_{rc}"]</option>
                }
            </select>

            @if (_schools.Count == 0)
            {
                <div class="lp-empty-state">@Loc["Admin_Empty"]</div>
            }
            <div class="adm-schools">
                @foreach (var s in _schools)
                {
                    var school = s;
                    <div class="adm-school">
                        <div class="adm-school-text">
                            <div class="adm-name">@school.Name</div>
                            <div class="adm-meta">@Loc[$"Region_{school.Region}"] · @Loc.Format("Admin_Staff", school.StaffCount)</div>
                        </div>
                        <button type="button" class="adm-verify @(school.IsVerified ? "on" : "")" @onclick="() => ToggleVerifiedAsync(school)">
                            @(school.IsVerified ? "✓ " + Loc["Admin_Verified"] : Loc["Admin_Unverified"])
                        </button>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    private static readonly (string Key, string Label)[] Statuses =
    [
        ("pending", "Admin_Pending"), ("approved", "Admin_Approved"), ("rejected", "Admin_Rejected")
    ];

    private bool _loaded, _busy;
    private string _tab = "requests";
    private string _status = "pending";
    private string _message = string.Empty, _error = string.Empty;

    private List<StaffRequestDto> _requests = new();
    private int _deciding;
    private string _decision = "approve";
    private List<SchoolDto> _regionSchools = new();
    private int _chosenSchool;
    private string _newSchoolName = string.Empty;
    private string _note = string.Empty;

    private List<AppVersionDto> _versions = new();
    private List<PlanUserDto> _planUsers = new();

    // ── ads ──
    private sealed class AdForm
    {
        public int Id;
        public string Title = string.Empty, Html = string.Empty, Mode = "fixed", IntervalUnit = "day";
        public string? ImageDataUrl, Lang;
        public bool RemoveImage, IsActive = true;
        public DateTime StartsLocal = DateTime.UtcNow.AddHours(5);
        public DateTime? EndsLocal;
        public int IntervalValue = 1;
        public TimeOnly DailyTime = new(18, 0);
    }
    private List<AdDto> _ads = new();
    private AdForm? _adForm;
    private bool _adPreview;
    private bool _adSource;                     // true: the html code is edited as text, not in the visual editor
    private bool _editorLive;
    private DotNetObjectReference<Admin>? _self;

    private void ToggleAdSource() => _adSource = !_adSource;

    /// <summary>Called by the visual editor (JS) with the html of the text after every change.</summary>
    [JSInvokable]
    public void OnEditorHtml(string html)
    {
        if (_adForm is not null) _adForm.Html = html;       // no redraw: the editor must not be disturbed while the person types
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        bool want = _tab == "ads" && _adForm is not null && !_adSource;
        if (want && !_editorLive)
        {
            _editorLive = true;
            _self ??= DotNetObjectReference.Create(this);
            try { await JS.InvokeVoidAsync("lp.quillInit", "ad-editor", _self, _adForm!.Html, Loc["Admin_Ad_Text"]); }
            catch { _editorLive = false; _adSource = true; StateHasChanged(); }          // the editor did not load: the html code is edited as text
        }
        else if (!want && _editorLive)
        {
            _editorLive = false;
            try { await JS.InvokeVoidAsync("lp.quillDestroy"); } catch { }
        }
    }

    // the admin works in the time of Uzbekistan (UTC+5); the server keeps UTC
    private static DateTime ToUtc(DateTime local) => DateTime.SpecifyKind(local.AddHours(-5), DateTimeKind.Utc);
    private static DateTime ToLocal(DateTime utc) => DateTime.SpecifyKind(utc.AddHours(5), DateTimeKind.Unspecified);

    private string IntervalText(int minutes) =>
        minutes % 1440 == 0 ? $"{minutes / 1440} {Loc["Admin_Ad_Days"]}" : minutes % 60 == 0 ? $"{minutes / 60} {Loc["Admin_Ad_Hours"]}" : $"{minutes} {Loc["Admin_Ad_Minutes"]}";

    private string AdSummary(AdDto a)
    {
        var from = a.StartsAt.AddHours(5).ToString("dd.MM.yyyy HH:mm");
        var text = a.Mode == "periodic" ? Loc.Format("Admin_Ad_SummaryPeriodic", IntervalText(a.IntervalMinutes), from)
                 : a.Mode == "daily" ? Loc.Format("Admin_Ad_SummaryDaily", new TimeOnly(a.DailyAtMinutes / 60, a.DailyAtMinutes % 60).ToString("HH:mm"), from)
                 : Loc.Format("Admin_Ad_SummaryFixed", from);
        return a.EndsAt is { } e ? text + " → " + e.AddHours(5).ToString("dd.MM.yyyy HH:mm") : text;
    }

    private void NewAd() { _message = _error = string.Empty; _adSource = false; _adForm = new AdForm(); }

    private async Task EditAdAsync(int id)
    {
        _message = _error = string.Empty;
        var a = await ApiClient.AdminGetAdAsync(id);
        if (a is null) return;
        _adSource = false;
        var unit = a.IntervalMinutes % 1440 == 0 && a.IntervalMinutes > 0 ? "day" : a.IntervalMinutes % 60 == 0 && a.IntervalMinutes > 0 ? "hour" : "min";
        _adForm = new AdForm
        {
            Id = a.Id, Title = a.Title, Html = a.Html, ImageDataUrl = a.ImageDataUrl, Mode = a.Mode, Lang = a.Lang, IsActive = a.IsActive,
            StartsLocal = ToLocal(a.StartsAt), EndsLocal = a.EndsAt is { } e ? ToLocal(e) : null,
            DailyTime = new TimeOnly(Math.Clamp(a.DailyAtMinutes, 0, 1439) / 60, Math.Clamp(a.DailyAtMinutes, 0, 1439) % 60),
            IntervalUnit = unit, IntervalValue = a.IntervalMinutes == 0 ? 1 : unit == "day" ? a.IntervalMinutes / 1440 : unit == "hour" ? a.IntervalMinutes / 60 : a.IntervalMinutes
        };
    }

    private async Task OnAdImagePicked(InputFileChangeEventArgs e)
    {
        if (_adForm is null) return;
        _error = string.Empty;
        if (e.File.Size > 1024 * 1024) { _error = Loc["Admin_Ad_Err_BAD_IMAGE"]; return; }
        using var ms = new MemoryStream();
        await e.File.OpenReadStream(1024 * 1024 + 1).CopyToAsync(ms);
        _adForm.ImageDataUrl = $"data:{e.File.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
        _adForm.RemoveImage = false;
    }

    private async Task SaveAdAsync()
    {
        if (_adForm is not { } f) return;
        _message = _error = string.Empty;
        _busy = true;
        try
        {
            int minutes = f.IntervalUnit == "day" ? f.IntervalValue * 1440 : f.IntervalUnit == "hour" ? f.IntervalValue * 60 : f.IntervalValue;
            await ApiClient.AdminSaveAdAsync(f.Id, new SaveAdRequest
            {
                Title = f.Title, Html = f.Html, Mode = f.Mode, IsActive = f.IsActive, Lang = string.IsNullOrEmpty(f.Lang) ? null : f.Lang,
                // an old picture is kept (null) unless a new one was picked or it was removed
                ImageDataUrl = f.Id == 0 || f.RemoveImage || f.ImageDataUrl is null ? f.ImageDataUrl : null, RemoveImage = f.RemoveImage,
                StartsAt = ToUtc(f.StartsLocal), EndsAt = f.EndsLocal is { } e ? ToUtc(e) : null, IntervalMinutes = f.Mode == "periodic" ? minutes : 0,
                DailyAtMinutes = f.Mode == "daily" ? f.DailyTime.Hour * 60 + f.DailyTime.Minute : 0
            });
            _adForm = null;
            _ads = await ApiClient.AdminGetAdsAsync();
            _message = Loc["Admin_Ad_Saved"];
        }
        catch (Exception ex) { _error = Loc[$"Admin_Ad_Err_{ex.Message}"]; }
        finally { _busy = false; }
    }

    private async Task DeleteAdAsync(AdDto a)
    {
        if (!await JS.InvokeAsync<bool>("confirm", Loc.Format("Admin_Ad_ConfirmDelete", a.Title))) return;
        try { await ApiClient.AdminDeleteAdAsync(a.Id); _ads = await ApiClient.AdminGetAdsAsync(); _message = Loc["Admin_Ad_Deleted"]; }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task ResetAdAsync(int id)
    {
        try { await ApiClient.AdminResetAdViewsAsync(id); _ads = await ApiClient.AdminGetAdsAsync(); _message = Loc["Admin_Ad_ResetDone"]; }
        catch (Exception ex) { _error = ex.Message; }
    }

    // ── prices of the versions and the balance ──
    private List<PlanPriceDto> _priceRows = new();
    private string _topUser = string.Empty, _topNote = string.Empty;
    private long? _topAmount;
    private List<BalanceTransactionDto> _balanceTx = new();

    // a price row of a version for a period (made when it is not there yet), for the input fields
    private PlanPriceDto PriceRef(string plan, string period)
    {
        var row = _priceRows.FirstOrDefault(r => r.Plan == plan && r.Period == period);
        if (row is null) { row = new PlanPriceDto { Plan = plan, Period = period }; _priceRows.Add(row); }
        return row;
    }

    private async Task SavePricesAsync()
    {
        _message = _error = string.Empty;
        _busy = true;
        try { _priceRows = await ApiClient.AdminSetPlanPricesAsync(_priceRows); _message = Loc["PR_Saved"]; }
        catch (Exception ex) { _error = Loc[$"PR_Err_{ex.Message}"]; }
        finally { _busy = false; }
    }

    private async Task TopUpAsync()
    {
        _message = _error = string.Empty;
        if (_topAmount is not { } amount) { _error = Loc["BA_Err_BAD_AMOUNT"]; return; }
        _busy = true;
        try
        {
            var user = await ApiClient.AdminTopUpAsync(new TopUpRequest { Username = _topUser, Amount = amount, Note = string.IsNullOrWhiteSpace(_topNote) ? null : _topNote });
            _message = Loc.Format("BA_Done", user?.PublicId ?? _topUser, Jumbo.Shared.Money.Format(user?.Balance ?? 0));
            _topAmount = null;
            _balanceTx = await ApiClient.AdminGetBalanceTransactionsAsync();
        }
        catch (Exception ex) { _error = Loc[$"BA_Err_{ex.Message}"]; }
        finally { _busy = false; }
    }

