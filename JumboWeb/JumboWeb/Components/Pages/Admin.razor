    private async Task SetStatusAsync(string status) { _status = status; _deciding = 0; await LoadRequestsAsync(); }

    private async Task LoadRequestsAsync()
    {
        try { _requests = await ApiClient.AdminGetStaffRequestsAsync(_status); }
        catch (Exception ex) { _error = ex.Message; _requests = new(); }
    }

    private async Task StartDecisionAsync(StaffRequestDto req, string decision)
    {
        _message = _error = string.Empty;
        _deciding = req.Id;
        _decision = decision;
        _note = string.Empty;
        _newSchoolName = req.SchoolName;

        if (decision == "approve")
        {
            try { _regionSchools = await ApiClient.AdminGetSchoolsAsync(req.Region); } catch { _regionSchools = new(); }
            // Pre-select an existing school with the same name, otherwise "create new".
            var same = _regionSchools.FirstOrDefault(s => string.Equals(s.Name, req.SchoolName, StringComparison.OrdinalIgnoreCase));
            _chosenSchool = same?.SchoolId ?? 0;
        }
    }

    private async Task ConfirmAsync(StaffRequestDto req)
    {
        _busy = true;
        _message = _error = string.Empty;
        try
        {
            if (_decision == "approve")
            {
                await ApiClient.AdminApproveStaffRequestAsync(req.Id, new ApproveStaffRequest
                {
                    SchoolId = _chosenSchool > 0 ? _chosenSchool : null,
                    NewSchoolName = _chosenSchool > 0 ? null : _newSchoolName,
                    Note = _note
                });
            }
            else
            {
                await ApiClient.AdminRejectStaffRequestAsync(req.Id, new RejectStaffRequest { Note = _note });
            }
            _deciding = 0;
            _message = Loc["Admin_Done"];
            await LoadRequestsAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task LoadSchoolsAsync()
    {
        try { _schools = await ApiClient.AdminGetSchoolsAsync(string.IsNullOrEmpty(_schoolRegion) ? null : _schoolRegion); }
        catch (Exception ex) { _error = ex.Message; _schools = new(); }
    }

    private async Task OnSchoolRegionChanged(ChangeEventArgs e) { _schoolRegion = e.Value?.ToString() ?? string.Empty; await LoadSchoolsAsync(); }

    private async Task AddSchoolAsync()
    {
        _message = _error = string.Empty;
        if (string.IsNullOrEmpty(_addRegion) || string.IsNullOrWhiteSpace(_addName)) return;
        _busy = true;
        try
        {
            await ApiClient.AdminCreateSchoolAsync(new CreateSchoolRequest { Region = _addRegion, Name = _addName.Trim() });
            _addName = string.Empty;
            _message = Loc["Admin_Done"];
            await LoadSchoolsAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task ToggleVerifiedAsync(SchoolDto school)
    {
        try
        {
            await ApiClient.AdminSetSchoolVerifiedAsync(school.SchoolId, !school.IsVerified);
            school.IsVerified = !school.IsVerified;
        }
        catch (Exception ex) { _error = ex.Message; }
    }
