@using System.Globalization
@using System.Text
@using JumboWeb.Services
@using Jumbo.Shared.Entities
@inject NavigationManager Nav
@inject AppLocalizer Loc

@* The picture of the snake (the header is in TopicSnake): the SAME road as in the mobile app. One thick body winds down: the first topic is on the
   left, the second lower on the right, the third on the left again, and so on; the road is an S-shaped bend between two neighbours. The topics
   are round markers lying on the road (the ring of three parts: one per game); the name stands beside the marker, on the free side. The part of
   the road that is passed has the colour of the level; the topic to play next is lit and has a bubble over it.
   The picture is drawn in a frame of its own units (700 wide, like the app) and scaled to the width; markers and names are placed in percent. *@
@{
    var g = Layout();
}
<div class="snake narrow" style="aspect-ratio: @Inv(W) / @Inv(g.Height); --u: @Inv(100 / W)cqw; --road: @Inv(Node); --edge: @Inv(Node + Edge); --dot: @Inv(Dot); --gap: @Inv(Gap)">
    <svg class="snake-svg" viewBox="0 0 @Inv(W) @Inv(g.Height)" preserveAspectRatio="xMidYMin meet" aria-hidden="true">
        <path class="snake-edge" d="@g.Body" />
        <path class="snake-body" d="@g.Body" />
        @if (g.GreenLen > 0)
        {
            <path class="snake-edge on" d="@g.Body" stroke-dasharray="@Inv(g.GreenLen) @Inv(g.Total + 600)" />
            <path class="snake-body on" d="@g.Body" stroke-dasharray="@Inv(g.GreenLen) @Inv(g.Total + 600)" />
        }
        <path class="snake-scales" d="@g.Body" />
    </svg>

    @foreach (var p in g.Nodes)
    {
        var topic = p.Topic;
        var st = StateOf(topic);
        var parts = PartsOf(topic);
        bool leftLane = p.Index % 2 == 0;
        <button type="button" class="snake-node @st @(IsLocked(topic) ? "locked" : "")" title="@topic.SubjectName"
                style="left: @Inv(p.X / W * 100)%; top: @Inv(p.Y / g.Height * 100)%; width: @Inv(Node / W * 100)%" @onclick="() => Open(topic)">
            @if (st == "current")
            {
                <span class="snake-bubble">@Loc[parts > 0 ? "Path_Continue" : "Path_Start"]</span>
            }
            <span class="snake-disc ring3 parts-@parts">
                <span class="snake-num">@(st == "done" ? "✓" : (p.Index + 1).ToString())</span>
                @if (IsLocked(topic)) { <span class="snake-lock" aria-hidden="true">🔒</span> }
            </span>
        </button>
        <span class="snake-name side @(leftLane ? "l" : "r") @st" style="left: @Inv(p.LabelX / W * 100)%; top: @Inv(p.Y / g.Height * 100)%; width: @Inv(p.LabelW / W * 100)%">@topic.SubjectName</span>
    }
</div>

@code {
    // the units of the app (SnakeView.cs): a 700-wide frame, two lanes, a marker of 100, a row of 262
    private const double W = 700, XL = 200, XR = 500, Y0 = 110, Row = 262, Node = 100, Edge = 12, Dot = 7, Gap = 22, Under = 36;

    [Parameter] public bool Wide { get; set; }          // (not used any more: one picture for every screen, like the app)
    [Parameter] public List<Subject> Path { get; set; } = new();
    [Parameter] public Dictionary<int, UserSubjectProgress> Progress { get; set; } = new();

    /// <summary>A locked topic was pressed: the topic that has to be passed first.</summary>
    [Parameter] public EventCallback<Subject> OnLocked { get; set; }

    private record Place(int Index, Subject Topic, double X, double Y, double S, double LabelX, double LabelW);
    private record SnakeLayout(List<Place> Nodes, string Body, double Total, double GreenLen, double Height);

    // Razor's default interpolation uses the culture of the user: a comma would break the SVG numbers.
    private static string Inv(double d) => d.ToString("0.###", CultureInfo.InvariantCulture);

    private SnakeLayout Layout()
    {
        var nodes = new List<Place>();
        var d = new StringBuilder();
        double total = 0;
        double edge = Edge / 2 + 6 + 10;                              // the ring edge and the gap between the marker and its name
        for (int i = 0; i < Path.Count; i++)
        {
            double x = i % 2 == 0 ? XL : XR, y = Y0 + i * Row;
            // the name beside the marker, on the free side: left of a left marker, right of a right one
            double lx, lw;
            if (i % 2 == 0) { lw = x - Node / 2 - edge - 6; lx = 6; }
            else { double start = x + Node / 2 + edge; lw = W - start - 6; lx = start; }
            nodes.Add(new Place(i, Path[i], x, y, total, lx, lw));

            if (i == 0) d.Append($"M {Inv(x)} {Inv(y)}");
            if (i < Path.Count - 1)
            {
                double bx = (i + 1) % 2 == 0 ? XL : XR, by = Y0 + (i + 1) * Row, dy = by - y;
                d.Append($" C {Inv(x)} {Inv(y + dy * 0.62)} {Inv(bx)} {Inv(by - dy * 0.62)} {Inv(bx)} {Inv(by)}");
                total += BezierLength(x, y, x, y + dy * 0.62, bx, by - dy * 0.62, bx, by);
            }
        }

        var first = nodes.FirstOrDefault(p => !IsDone(p.Topic));
        double green = first is null ? total : first.S;
        double height = Y0 + Math.Max(Path.Count - 1, 0) * Row + Node / 2 + Under;
        return new SnakeLayout(nodes, d.ToString(), total, green, height);
    }

    private static double BezierLength(double x0, double y0, double x1, double y1, double x2, double y2, double x3, double y3)
    {
        double len = 0, px = x0, py = y0;
        for (int t = 1; t <= 40; t++)
        {
            double u = t / 40.0, v = 1 - u;
            double x = v * v * v * x0 + 3 * v * v * u * x1 + 3 * v * u * u * x2 + u * u * u * x3;
            double y = v * v * v * y0 + 3 * v * v * u * y1 + 3 * v * u * u * y2 + u * u * u * y3;
            len += Math.Sqrt((x - px) * (x - px) + (y - py) * (y - py));
            px = x; py = y;
        }
        return len;
    }

    private int PartsOf(Subject s) => Progress.TryGetValue(s.SubjectId, out var p) ? p.PartsDone : 0;
    private bool IsDone(Subject s) => PartsOf(s) >= UserSubjectProgress.Parts;
    private Subject? Current => Path.FirstOrDefault(s => !IsDone(s));

    // done = all three games won; current = the first topic that is not finished; started = partly played; future = not touched yet.
    private string StateOf(Subject s)
    {
        if (IsDone(s)) return "done";
        if (Current is { } cur && cur.SubjectId == s.SubjectId) return "current";
        return PartsOf(s) > 0 ? "started" : "future";
    }

    // A topic opens when the topic before it is passed: the ones up to the first topic that is not passed (that one included) are open,
    // the ones after it are locked (a topic that is passed stays open).
    private bool IsLocked(Subject s) => Current is { } cur && !IsDone(s) && Path.IndexOf(s) > Path.IndexOf(cur);

    private async Task Open(Subject s)
    {
        if (IsLocked(s) && Current is { } cur)
        {
            await OnLocked.InvokeAsync(cur);
            return;
        }
        Nav.NavigateTo($"/little-polyglot/subjects/{s.BookId}/{s.SubjectId}");
    }
}
