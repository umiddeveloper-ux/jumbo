@inject JumboWeb.Services.AppLocalizer Loc

@* The eye at the right end of a password field: shows / hides what is typed. It sits next to the input inside <div class="pw-wrap">;
   the switch is plain browser code (lp.togglePw), so it works for InputText and <input> alike and never touches the bound value. *@
<button type="button" class="pw-eye" tabindex="-1" aria-pressed="false"
        title="@Loc["Pw_Show"]" aria-label="@Loc["Pw_Show"]" data-show="@Loc["Pw_Show"]" data-hide="@Loc["Pw_Hide"]"
        onclick="lp.togglePw(this)">
    <svg class="pw-ico pw-ico-open" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M1.5 12S5.5 5 12 5s10.5 7 10.5 7-4 7-10.5 7S1.5 12 1.5 12z" />
        <circle cx="12" cy="12" r="3" />
    </svg>
    <svg class="pw-ico pw-ico-off" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 3l18 18" />
        <path d="M10.6 6.1A10.9 10.9 0 0 1 12 6c6.5 0 10.5 6 10.5 6a17.6 17.6 0 0 1-3.2 3.9" />
        <path d="M6.6 6.7C3.4 8.6 1.5 12 1.5 12S5.5 18 12 18c1.5 0 2.9-.3 4.1-.8" />
        <path d="M9.9 9.9a3 3 0 0 0 4.2 4.2" />
    </svg>
</button>
