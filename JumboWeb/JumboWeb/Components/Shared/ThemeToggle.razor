@using JumboWeb.Services
@inject AppLocalizer Loc
@inject IJSRuntime JS

@* Icon swap is pure CSS (driven by <html data-theme>), so no component state has to stay in sync. *@
<button type="button" class="theme-toggle @Class" title="@Loc["Theme_Toggle"]" aria-label="@Loc["Theme_Toggle"]"
        @onclick="Toggle">
    <span class="tt-moon">🌙</span><span class="tt-sun">☀️</span>
</button>

@code {
    [Parameter] public string? Class { get; set; }

    private async Task Toggle() => await JS.InvokeVoidAsync("lp.toggleTheme");
}
