@using JumboWeb.Services
@inject AppLocalizer Loc
@inject LpApiClient ApiClient
@inject UserPreferencesService Prefs
@inject NavigationManager Nav
@inject IJSRuntime JS

@* The footer of the landing: the site links and the feedback / news form (the apps are in DownloadBand above it). *@
<footer class="foot">
    <div class="foot-in">
        <div class="foot-col foot-brand">
            <a class="land-brand" href="/"><img src="favicon.svg" alt="" /><span>@Loc["Common_BrandName"]</span></a>
            <p>@Loc["Foot_Tagline"]</p>
            <a class="foot-bot" href="https://t.me/JumboUzBot" target="_blank" rel="noopener">
                <span class="foot-bot-ico" aria-hidden="true">✈️</span>
                <span class="foot-bot-text"><small>@Loc["Foot_Bot"]</small><b>@@JumboUzBot</b></span>
            </a>
        </div>

        <div class="foot-col">
            <h3>@Loc["Foot_Site"]</h3>
            <ul class="foot-links">
                <li><a href="/plans">@Loc["Plan_Nav"]</a></li>
                <li><a href="/for-schools">@Loc["Foot_Schools"]</a></li>
                <li><a href="/login">@Loc["Land_Login"]</a></li>
                <li><a href="/register">@Loc["Land_Register"]</a></li>
                <li><a href="/privacy">@Loc["Foot_Privacy"]</a></li>
                <li><a href="/delete-account">@Loc["Foot_Delete"]</a></li>
            </ul>
        </div>

        <div class="foot-col foot-sub" id="contact">
            <h3>@Loc["Foot_Subscribe"]</h3>
            <p>@Loc["Foot_SubscribeHint"]</p>
            @if (_state == "done")
            {
                <div class="foot-ok" role="status">✓ @Loc["Foot_Subscribed"]</div>
            }
            else
            {
                <form class="foot-form" @onsubmit="SubscribeAsync" @onsubmit:preventDefault="true">
                    @* a field that people never see: a robot fills it in *@
                    <input class="foot-trap" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" @bind="_trap" />
                    <input class="foot-input" type="email" inputmode="email" autocomplete="email" maxlength="200" required
                           placeholder="@Loc["Foot_EmailPlaceholder"]" aria-label="@Loc["Foot_EmailPlaceholder"]" @bind="_email" @bind:event="oninput" />
                    <textarea class="foot-input foot-text" rows="3" maxlength="1000" placeholder="@Loc["Foot_MessagePlaceholder"]"
                              aria-label="@Loc["Foot_MessagePlaceholder"]" @bind="_message" @bind:event="oninput"></textarea>
                    <label class="foot-check"><input type="checkbox" @bind="_news" /> <span>@Loc["Foot_NewsCheck"]</span></label>
                    <button type="submit" class="lp-btn foot-btn" disabled="@(_state == "sending")">@(_state == "sending" ? Loc["Foot_Sending"] : Loc["Foot_SubscribeButton"])</button>
                </form>
                @if (_state == "bad") { <p class="foot-err">@Loc["Foot_BadEmail"]</p> }
                else if (_state == "empty") { <p class="foot-err">@Loc["Foot_NeedSomething"]</p> }
                else if (_state == "fail") { <p class="foot-err">@Loc["Foot_Failed"]</p> }
                <p class="foot-consent">@Loc["Foot_Consent"] <a href="/privacy">@Loc["Foot_Privacy"]</a></p>
            }
        </div>
    </div>
    <div class="foot-share">
        <span class="foot-share-label">@Loc["Foot_Share"]</span>
        <a class="share-btn s-tg" href="https://t.me/share/url?url=@Url&text=@Text" target="_blank" rel="noopener">Telegram</a>
        <a class="share-btn s-wa" href="@WaHref" target="_blank" rel="noopener">WhatsApp</a>
        <a class="share-btn s-fb" href="https://www.facebook.com/sharer/sharer.php?u=@Url" target="_blank" rel="noopener">Facebook</a>
        @* Instagram has no web "share" address: the link is copied and Instagram opens *@
        <a class="share-btn s-ig" href="https://www.instagram.com/" target="_blank" rel="noopener" @onclick='() => CopyAsync("Foot_IgHint")'>Instagram</a>
        <a class="share-btn s-x" href="https://twitter.com/intent/tweet?url=@Url&text=@Text" target="_blank" rel="noopener">X</a>
        <a class="share-btn s-vk" href="https://vk.com/share.php?url=@Url&title=@Text" target="_blank" rel="noopener">VK</a>
        <a class="share-btn s-ok" href="https://connect.ok.ru/offer?url=@Url&title=@Text" target="_blank" rel="noopener">OK</a>
        <button type="button" class="share-btn s-copy" @onclick='() => CopyAsync("Foot_Copied")'>🔗 @Loc["Foot_Copy"]</button>
        @if (!string.IsNullOrEmpty(_note)) { <span class="foot-share-note" role="status">@_note</span> }
    </div>
    <div class="foot-bottom">© @DateTime.UtcNow.Year @Loc["Common_BrandName"]</div>
</footer>

@code {
    private string _email = string.Empty, _message = string.Empty, _trap = string.Empty, _state = "idle";
    private bool _news = true;
    private string _note = string.Empty;

    // what is shared: the address of the site and a short text
    private string Url => Uri.EscapeDataString(Nav.ToAbsoluteUri("/").ToString());
    private string Text => Uri.EscapeDataString(Loc["Foot_ShareText"]);
    private string WaHref => $"https://wa.me/?text={Text}%20{Url}";

    private async Task CopyAsync(string noteKey)
    {
        try
        {
            var done = await JS.InvokeAsync<bool>("lp.copyTextSafe", Nav.ToAbsoluteUri("/").ToString());
            _note = done ? Loc[noteKey] : Nav.ToAbsoluteUri("/").ToString();       // no clipboard at all: the address itself is shown
        }
        catch { _note = Nav.ToAbsoluteUri("/").ToString(); }
        StateHasChanged();
        await Task.Delay(4500);
        _note = string.Empty;
        StateHasChanged();
    }

    private async Task SubscribeAsync()
    {
        if (_state == "sending") return;
        if (!string.IsNullOrEmpty(_trap)) { _state = "done"; return; }        // a robot: it thinks it has subscribed
        if (string.IsNullOrWhiteSpace(_message) && !_news) { _state = "empty"; return; }
        _state = "sending";
        try
        {
            await Prefs.EnsureLoadedAsync();
            var lang = Prefs.AppLangId switch { 2 => "ru", 3 => "uz", _ => "en" };
            _state = await ApiClient.SubscribeAsync(_email, lang, _message, _news) ? "done" : "bad";
        }
        catch { _state = "fail"; }
    }
}
