@implements IAsyncDisposable
@using Jumbo.Shared.Dtos
@using JumboWeb.Services
@inject LpApiClient ApiClient
@inject UserStateService UserState
@inject NavigationManager Nav

@* Asks the server "is there an ad for me now?" a little after the site is opened and then every few minutes, and shows it in a window. The server
   answers with an ad only for a registered learner of the free version when the time of an ad has come. Nothing is shown in the middle of a game
   or an exam. *@
@if (_ad is not null)
{
    <AdDialog Title="@_ad.Title" Html="@_ad.Html" ImageDataUrl="@_ad.ImageDataUrl" OnClose="Close" />
}

@code {
    private static readonly TimeSpan FirstAfter = TimeSpan.FromSeconds(20);
    private static readonly TimeSpan Every = TimeSpan.FromMinutes(3);

    private AdForUserDto? _ad;
    private CancellationTokenSource? _cts;

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        _cts = new CancellationTokenSource();
        _ = LoopAsync(_cts.Token);
    }

    private async Task LoopAsync(CancellationToken ct)
    {
        try
        {
            await Task.Delay(FirstAfter, ct);
            while (!ct.IsCancellationRequested)
            {
                await CheckAsync();
                await Task.Delay(Every, ct);
            }
        }
        catch (OperationCanceledException) { }
        catch { /* an ad is never worth breaking the page */ }
    }

    private async Task CheckAsync()
    {
        if (_ad is not null || !UserState.IsRegistered || UserState.HidesLessons || InTheMiddleOfSomething()) return;
        AdForUserDto? ad;
        try { ad = await ApiClient.GetNextAdAsync(); } catch { return; }
        if (ad is null) return;
        _ad = ad;
        await InvokeAsync(StateHasChanged);
    }

    // a game, an exam or a test: the ad waits for the next check
    private bool InTheMiddleOfSomething()
    {
        var path = new Uri(Nav.Uri).AbsolutePath;
        return path.Contains("/games/", StringComparison.OrdinalIgnoreCase) || path.Contains("/quiz", StringComparison.OrdinalIgnoreCase)
            || path.EndsWith("/test", StringComparison.OrdinalIgnoreCase) || path.EndsWith("/recall", StringComparison.OrdinalIgnoreCase);
    }

    private void Close() => _ad = null;

    public ValueTask DisposeAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        return ValueTask.CompletedTask;
    }
}
